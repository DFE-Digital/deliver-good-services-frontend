@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{
  var gtmContainerId = HostEnvironment.IsEnvironment("Test")
    ? (Configuration["Analytics:GtmContainerId"] ?? "GTM-WFXD8W9G")
    : (HostEnvironment.IsEnvironment("Production") ? Configuration["Analytics:GtmContainerId"] : null);
}
<!DOCTYPE html>
<html lang="en" class="govuk-template--rebranded">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DfE Service Manual</title>
    <link rel="stylesheet" href="~/css/govuk-frontend.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/moj-frontend.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/inter.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/service-manual.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dfe-f-panel-container.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/font-awesome/css/all.min.css" asp-append-version="true" />
    <link rel="shortcut icon" href="~/favicon.ico" type="image/x-icon" />
    <link rel="mask-icon" href="~/favicon.ico" color="#0b0c0c" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/favicon.ico" />
    <meta name="theme-color" content="#0b0c0c" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="format-detection" content="telephone=no" />
    @if (!string.IsNullOrWhiteSpace(gtmContainerId))
    {
        <!-- Google Tag Manager -->
        <script>
            (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
            new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
            j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
            'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
            })(window,document,'script','dataLayer','@gtmContainerId');
        </script>
        <!-- End Google Tag Manager -->
    }
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="govuk-template__body @(IsSectionDefined("Breadcrumbs") ? "has-breadcrumbs" : "")">
  @if (!string.IsNullOrWhiteSpace(gtmContainerId))
  {
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=@gtmContainerId"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
  }
  <script>
    document.body.className += ' js-enabled' + ('noModule' in HTMLScriptElement.prototype ? ' govuk-frontend-supported' : '');
  </script>


  <a href="#main-content" class="govuk-skip-link">Skip to main content</a>


  @await Html.PartialAsync("_Header")

  @* When Masthead is defined (e.g. lifecycle/phase), breadcrumbs live inside the masthead – do not render a separate breadcrumb bar *@
  @if (IsSectionDefined("Breadcrumbs") && !IsSectionDefined("Masthead"))
  {
    @if (ViewBag.BreadcrumbWrapperType as string == "topic" ||
          (ViewBag.BreadcrumbWrapperType == null && ViewContext.RouteData.Values["controller"]?.ToString() == "Standards" && ViewContext.RouteData.Values["action"]?.ToString() == "Index"))
    {
      <div class="breadcrumbs-wrapper breadcrumbs-wrapper--topic-page">
        <div class="govuk-width-container">
          <nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
            <ol class="govuk-breadcrumbs__list">
              @RenderSection("Breadcrumbs", required: false)
            </ol>
          </nav>
        </div>
      </div>
    }
    else
    {
      <div class="govuk-width-container">
        <nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
          <ol class="govuk-breadcrumbs__list">
            @RenderSection("Breadcrumbs", required: false)
          </ol>
        </nav>
      </div>
    }
  }
<main id="main" id="main-content" role="main">
  @RenderSection("Masthead", required: false)

  <div class="govuk-main-wrapper">
    @if (IsSectionDefined("Masthead"))
    {
      <div class="content-wrapper">
        <div class="govuk-width-container">
          @RenderBody()
        </div>
      </div>
    }
    else
    {
      <div class="govuk-width-container">
        @RenderBody()
      </div>
    }
  </div>
</main>
  @await Html.PartialAsync("_Footer")

  @await RenderSectionAsync("Scripts", required: false)

  <script type="module" src="/js/govuk-frontend.min.js"></script>
  <script type="module">
    import { initAll } from '/js/moj-frontend.min.js';
    initAll();
  </script>
  <script src="/js/site.js"></script>
  <script src="/js/library.js"></script>
  <script src="/js/dfe-f-panel-container.js"></script>
  <script src="/js/dfe-sortable-table.js"></script>
  <script type="module">
    import { initAll } from '/js/govuk-frontend.min.js'
    initAll()
  </script>
</body>
</html>


<header class="govuk-header govuk-js-header-search" data-module="govuk-header">
  <div class="govuk-header__container govuk-width-container">
    <div class="govuk-header__logo">
      <a href="https://www.gov.uk/government/organisations/department-for-education" class="govuk-header__link govuk-header__link--homepage">
        <img src="/images/department-for-education_white.png" alt="Department for Education" class="govuk-header__logotype">
      </a>
    </div>
  </div>

  </div>
</header>

@{
  var isDocumentationNav = ViewData["IsDocumentationNav"] as bool? == true;
}
<section aria-label="Service information" class="govuk-service-navigation @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "govuk-service-navigation--inverse" : "") @(isDocumentationNav ? "govuk-service-navigation--documentation" : "")" data-module="govuk-service-navigation">
  <div class="govuk-width-container">
    <div class="govuk-service-navigation__container">
      <span class="govuk-service-navigation__service-name">
        @if (isDocumentationNav)
        {
          <a href="/documentation" class="govuk-service-navigation__link">Documentation</a>
        }
        else
        {
          <a href="/" class="govuk-service-navigation__link">Deliver good services</a>
        }
      </span>
      @await Html.PartialAsync("_Navigation")
    </div>
  </div>
</section>


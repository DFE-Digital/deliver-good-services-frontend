@using ServiceManual.Models
@{
    var navItems = ViewData["Navigation"] as List<NavigationItem> ?? [];
    var currentPath = Context.Request.Path.Value ?? string.Empty;

    var activeParent = navItems.FirstOrDefault(item =>
    {
        var isActive = ServiceNavigationActiveHelper.IsServiceNavItemActive(item.Url, currentPath);
        var hasActiveChild = item.Children.Any(c =>
            ServiceNavigationActiveHelper.IsServiceNavItemActive(c.Url, currentPath));
        return item.Children.Any() && (isActive || hasActiveChild);
    });
}

@if (activeParent is not null && activeParent.Children.Any())
{
    <nav aria-label="@activeParent.Title" class="dfe-secondary-nav" data-module="govuk-service-navigation">
        <div class="govuk-width-container">
            <ul class="dfe-secondary-nav__list">
                @foreach (var child in activeParent.Children)
                {
                    var isChildActive = ServiceNavigationActiveHelper.IsServiceNavItemActive(child.Url, currentPath);

                    <li class="dfe-secondary-nav__item @(isChildActive ? "dfe-secondary-nav__item--active" : "")">
                        @if (child.Url is not null)
                        {
                            <a class="dfe-secondary-nav__link" href="@child.Url" @(isChildActive ? Html.Raw("aria-current=\"page\"") : null)>
                                @child.Title
                            </a>
                        }
                        else
                        {
                            <span class="dfe-secondary-nav__link dfe-secondary-nav__link--no-href">@child.Title</span>
                        }
                    </li>
                }
            </ul>
        </div>
    </nav>
}

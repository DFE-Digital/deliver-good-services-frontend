@using ServiceManual.Helpers
@using ServiceManual.Models
@{
    var page = ViewBag.ToolsPage as ToolsPage ?? new ToolsPage();
    var title = string.IsNullOrWhiteSpace(page.Title) ? "Tools" : page.Title;
    ViewData["Title"] = title;

    ViewBag.HeroType = "collection";
    ViewBag.HeroTitle = title;
    ViewBag.HeroIntro = string.IsNullOrWhiteSpace(page.Description)
        ? "Self-serve tools and calculators to support accessible, user-centred delivery — from population estimates to other utilities we publish here."
        : page.Description!;
    ViewBag.HeroBadgeText = "Tools";
    ViewBag.HeroMetaDescription = string.Empty;
    ViewBag.UseInverseNav = true;
    ViewBag.HeroBreadcrumbItems = new List<(string Title, string? Url)>
    {
        ("Home", "/"),
        (title, null)
    };

    var bodyHtml = string.IsNullOrWhiteSpace(page.Body)
        ? string.Empty
        : GovUkMarkdownHelper.ToGovUkHtmlForBody(page.Body);

    var cardItems = page.Tools
        .Where(tool => !string.IsNullOrWhiteSpace(tool.Title) && !string.IsNullOrWhiteSpace(tool.Url))
        .Select(tool => new
        {
            Title = tool.Title,
            Description = tool.Description ?? string.Empty,
            Href = tool.Url,
            tool.OpenInNewTab
        })
        .ToList();

    var cardColumns = cardItems.Count >= 2 ? 2 : 1;
}

<div class="guide-modern tools-index">
    @await Html.PartialAsync("~/Views/Shared/_HeroSection.cshtml")

    <div class="tools-index__content govuk-!-margin-bottom-9">
        <div class="govuk-width-container">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">
                    @if (!string.IsNullOrWhiteSpace(bodyHtml))
                    {
                        <div class="tools-index__body dfe-f-body govuk-!-margin-bottom-6">
                            @Html.Raw(bodyHtml)
                        </div>
                    }

                    @if (cardItems.Count > 0)
                    {
                        <h2 class="govuk-heading-m tools-index__list-heading">All tools</h2>
                        <p class="govuk-body tools-index__list-lede">Choose a tool to open it. Some links open in a new tab when they go to an external system.</p>
                        @await Html.PartialAsync("~/Views/Shared/_CardList.cshtml", null, new ViewDataDictionary(ViewData)
                        {
                            ["Items"] = cardItems,
                            ["Columns"] = cardColumns
                        })
                    }
                    else
                    {
                        <div class="govuk-inset-text">
                            <h2 class="govuk-heading-m govuk-!-margin-top-0">No tools listed yet</h2>
                            <p class="govuk-body govuk-!-margin-bottom-2">There are no tools to show from the content source. Check back later, or browse <a class="govuk-link" href="/guidance">guidance</a> in the meantime.</p>
                            <p class="govuk-body govuk-!-margin-bottom-0">If you edit the tools page in the CMS, publish it to update this list.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@using ServiceManual.Controllers
@using ServiceManual.Models
@model SearchViewModel
@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.Keywords) ? "Search" : $"Search results for \"{Model.Keywords}\"";
    var hasQuery = !string.IsNullOrEmpty(Model.Keywords);
}

@section Breadcrumbs {
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="/">Home</a></li>
  <li class="govuk-breadcrumbs__list-item" aria-current="page">Search</li>
}

@{
  var hasResults = hasQuery && Model.Results.Count > 0;
  var noResults = hasQuery && Model.Results.Count == 0;
}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    <h1 class="govuk-heading-xl govuk-!-margin-top-5">Search this site</h1>
  </div>
</div>

@if (!hasQuery || noResults)
{
  @* Default (no query) or no results: single two-thirds column, no one-third *@
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <form method="get" action="/search" class="search-facets" role="search">
        <div class="gem-c-search gem-c-search--large gem-c-search--on-white gem-c-search--separate-label govuk-!-margin-bottom-4" data-module="gem-search-page">
          <label class="govuk-label govuk-label--m gem-c-search-page__label" for="search-page-keywords">Search</label>
          <div id="search-page-hint" class="govuk-hint govuk-!-margin-top-1">Searches guidance, collections, guides, pages and standards.</div>
          <div class="gem-c-search__item-wrapper">
            <div class="gem-c-search-page__input-wrapper">
              <input class="gem-c-search__input gem-c-search__item" id="search-page-keywords" name="keywords" type="search" value="@Model.Keywords" placeholder="e.g. accessibility" autocomplete="off">
            </div>
            <div class="gem-c-search__item gem-c-search__submit-wrapper">
              <button class="gem-c-search__submit" type="submit" enterkeyhint="search">
                <span class="gem-c-search__submit-text">Search</span>
                <svg class="gem-c-search__icon" width="27" height="27" viewBox="0 0 27 27" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                  <circle cx="12.0161" cy="11.0161" r="8.51613" stroke="currentColor" stroke-width="3"></circle>
                  <line x1="17.8668" y1="17.3587" x2="26.4475" y2="25.9393" stroke="currentColor" stroke-width="3"></line>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </form>
      @if (noResults)
      {
        <p class="govuk-body govuk-!-margin-top-2">No results for <strong>@Model.Keywords</strong>. Try different keywords.</p>
      }
    </div>
  </div>
}
else
{
  @* Has results: one-third (search + filters) + two-thirds (results) *@
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-one-third">
      <aside class="dfe-standards-filter" aria-label="Filter results">
        <div class="dfe-standards-filter__panel">
          <h2 class="dfe-standards-filter__title">Filter results</h2>
          <form method="get" action="/search" class="dfe-standards-filter__form" role="search">
            <div class="dfe-standards-filter__field">
              <label class="dfe-standards-filter__label" for="search-page-keywords">Keyword search</label>
              <input class="govuk-input govuk-input--width-full" id="search-page-keywords" name="keywords" type="search" value="@Model.Keywords" placeholder="e.g. accessibility" autocomplete="off">
            </div>
            @if (Model.Facets.Count > 0)
            {
              <div class="dfe-standards-filter__field">
                <fieldset class="govuk-fieldset" aria-describedby="type-hint">
                  <legend class="dfe-standards-filter__label govuk-!-margin-bottom-2">Content type</legend>
                  <div id="type-hint" class="govuk-hint govuk-!-margin-bottom-2">Select one or more. Content types in the current results.</div>
                  <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
                    @{ var facetIndex = 0; }
                    @foreach (var facet in Model.Facets)
                    {
                      var isChecked = Model.Types.Contains(facet.ContentType, StringComparer.OrdinalIgnoreCase);
                      var id = "facet-type-" + facetIndex;
                      facetIndex++;
                      <div class="govuk-checkboxes__item">
                        <input class="govuk-checkboxes__input" id="@id" name="type" type="checkbox" value="@facet.ContentType" checked="@(isChecked ? "checked" : null)">
                        <label class="govuk-label govuk-checkboxes__label" for="@id">@facet.ContentType <span class="govuk-body-s govuk-!-font-weight-regular">(@facet.Count)</span></label>
                      </div>
                    }
                  </div>
                </fieldset>
              </div>
            }
            <div class="dfe-standards-filter__actions">
              <button type="submit" class="govuk-button govuk-button--primary govuk-!-margin-bottom-0" data-module="govuk-button">Apply filters</button>
              <a href="/search?keywords=@Uri.EscapeDataString(Model.Keywords)" class="dfe-standards-filter__secondary-link govuk-link govuk-link--no-visited-state">Clear all filters</a>
            </div>
          </form>
        </div>
      </aside>
    </div>

    <div class="govuk-grid-column-two-thirds">
      @if (Model.Types.Count > 0)
      {
        <div class="dfe-standards-filter__applied dfe-standards-filter__applied--above-results govuk-!-margin-bottom-4">
          <p class="dfe-standards-filter__applied-heading">Applied filters</p>
          <ul class="dfe-standards-filter__chips">
            @foreach (var type in Model.Types)
            {
              var otherTypes = Model.Types.Where(t => !string.Equals(t, type, StringComparison.OrdinalIgnoreCase)).ToList();
              var query = string.Join("&", otherTypes.Select(t => "type=" + Uri.EscapeDataString(t)));
              var clearTypeUrl = "/search?keywords=" + Uri.EscapeDataString(Model.Keywords) + (query.Length > 0 ? "&" + query : "");
              <li>
                <span class="dfe-standards-filter__chip">
                  <span class="dfe-standards-filter__chip-text">@type</span>
                  <a href="@clearTypeUrl" class="dfe-standards-filter__chip-remove" aria-label="Remove @type filter"><span aria-hidden="true">×</span></a>
                </span>
              </li>
            }
          </ul>
          <a href="/search?keywords=@Uri.EscapeDataString(Model.Keywords)" class="dfe-standards-filter__clear-all govuk-link govuk-link--no-visited-state">Clear all filters</a>
        </div>
      }
      <p class="govuk-body govuk-!-margin-bottom-4"><strong>@Model.Results.Count</strong> result@(Model.Results.Count == 1 ? "" : "s") for @Model.Keywords</p>
      <ul class="govuk-list">
        @foreach (var item in Model.Results)
        {
          <li class="govuk-!-margin-bottom-4">
            <h2 class="govuk-heading-m govuk-!-margin-bottom-1">
              <a href="@item.Url" class="govuk-link">@item.Title</a>
            </h2>
            <span class="govuk-body-s govuk-!-margin-right-2" style="color: #505a5f;">@item.ContentType</span>
            @if (!string.IsNullOrWhiteSpace(item.PartOfCollectionTitle) && !string.IsNullOrWhiteSpace(item.PartOfCollectionUrl))
            {
              <span class="govuk-body-s govuk-!-margin-right-2" style="color: #505a5f;">Part of collection: <a href="@item.PartOfCollectionUrl" class="govuk-link">@item.PartOfCollectionTitle</a></span>
            }
            @if (!string.IsNullOrWhiteSpace(item.Summary))
            {
              <p class="govuk-body govuk-body-s govuk-!-margin-top-1">@item.Summary</p>
            }
          </li>
        }
      </ul>
    </div>
  </div>
}

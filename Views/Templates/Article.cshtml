@model ServiceManual.Models.Article
@{
    ViewData["Title"] = Model.Title;
    var bodyHtml = ViewBag.BodyHtml as string ?? string.Empty;

    ViewBag.HeroType = "article";
    ViewBag.HeroTitle = Model.Title;
    ViewBag.HeroIntro = Model.MetaDescription ?? string.Empty;
    ViewBag.HeroBadgeText = "Article";
    ViewBag.HeroPublishedFromDisplay = Model.PublishedFromDisplay;
    ViewBag.HeroPublishedToDisplay = Model.PublishedToDisplay;
    ViewBag.HeroAuthor = Model.Author;
    ViewBag.HeroBreadcrumbItems = new List<(string Title, string Url)>
    {
        ("Home", "/"),
        ("Articles", "/articles"),
        (Model.Title, null!)
    };

    var currentPath = Context?.Request?.Path.Value ?? "/article/" + Model.RouteKey;
    var requestScheme = Context?.Request?.Scheme ?? "https";
    var requestHost = Context?.Request?.Host.Value ?? string.Empty;
    var canonicalCurrentUrl = $"{requestScheme}://{requestHost}{currentPath}";
}

<div class="guide-modern">
    @await Html.PartialAsync("~/Views/Shared/_HeroSection.cshtml")

    <div class="govuk-grid-row guide-content-row guide-content-row--no-contents">
        <div class="govuk-grid-column-two-thirds">
            <section class="dfe-f-content-section guide-content-section guide-content-section--no-contents" aria-label="Article content">
        

                @if (!string.IsNullOrWhiteSpace(Model.LeadImageUrl))
                {
                    <figure class="guide-article-image govuk-!-margin-bottom-6 govuk-!-margin-top-1">
                        <img class="article-img" src="@Model.LeadImageUrl" alt="@(Model.LeadImageAlt ?? string.Empty)" alt="" loading="lazy" />
                    </figure>
                }

                @if (!string.IsNullOrWhiteSpace(bodyHtml))
                {
                    <div class="dfe-f-body">
                        @Html.Raw(bodyHtml)
                    </div>
                }
            </section>
        </div>

        <div class="govuk-grid-column-one-third">
            @await Html.PartialAsync("~/Views/Shared/_SharePage.cshtml", null, new ViewDataDictionary(ViewData)
            {
                ["ShareTitle"]     = Model.Title,
                ["ShareUrl"]       = canonicalCurrentUrl,
                ["LibId"]          = currentPath,
                ["LibTitle"]       = Model.Title,
                ["LibUrl"]         = currentPath,
                ["LibType"]        = "Article",
                ["LibDescription"] = Model.MetaDescription ?? string.Empty
            })
        </div>
    </div>
</div>

@using ServiceManual.Helpers
@using ServiceManual.Models
@{
    var jobSpec = ViewBag.JobSpecification as JobSpecification ?? new JobSpecification();
    var professionDescriptionHtml = GovUkMarkdownHelper.ToGovUkHtmlForBody(jobSpec.Profession?.ProfessionDescription);
    var roleDescriptionHtml = GovUkMarkdownHelper.ToGovUkHtmlForBody(jobSpec.RoleDescription);
    var skillsHtml = GovUkMarkdownHelper.ToGovUkHtmlForBody(jobSpec.Skills);
    ViewData["Title"] = jobSpec.Title;
    var collectionSlug = ViewBag.CollectionSlug as string;
    var collectionTitle = ViewBag.CollectionTitle as string;
    var hasCollection = !string.IsNullOrEmpty(collectionSlug) && !string.IsNullOrEmpty(collectionTitle);
    var hasRightPanel = jobSpec.SiblingJobSpecifications.Count > 0 || jobSpec.EnableWordDocDownload;
    var professionTitle = jobSpec.Profession?.Plural ?? jobSpec.Profession?.Title ?? "Job descriptions";
    var hasProfessionDescription = !string.IsNullOrWhiteSpace(jobSpec.Profession?.ProfessionDescription);
    var hasRoleDescription = !string.IsNullOrWhiteSpace(jobSpec.RoleDescription);
    var hasSkills = !string.IsNullOrWhiteSpace(jobSpec.Skills);
    var contentsItems = new List<(string Title, string Id)>();
    if (hasProfessionDescription) { contentsItems.Add(("What " + (jobSpec.Profession?.Plural ?? jobSpec.Profession?.Title ?? "people").ToLowerInvariant() + " do", "profession-description-heading")); }
    if (hasRoleDescription) { contentsItems.Add(("Role responsibilities", "you-will-heading")); }
    if (hasSkills) { contentsItems.Add(("Skills you need", "skills-heading")); }
    var hasContents = contentsItems.Count > 0;

    // Setup hero section parameters (aligned with DetailedGuide)
    ViewBag.HeroType = "guidance";
    ViewBag.HeroTitle = jobSpec.Title;
    ViewBag.HeroIntro = !string.IsNullOrEmpty(jobSpec.Grade) ? $"Grade {jobSpec.Grade}" : "";
    ViewBag.HeroBadgeText = "Job description";
    ViewBag.HeroCollectionSlug = collectionSlug;
    ViewBag.HeroCollectionTitle = collectionTitle;
}

<div class="guide-modern">
    @await Html.PartialAsync("~/Views/Shared/_HeroSection.cshtml")

    @if (hasContents)
    {
        <div class="govuk-grid-row">
            <div class="@(hasRightPanel ? "govuk-grid-column-two-thirds" : "govuk-grid-column-full")">
                <nav class="guide-contents guide-contents--dashed" aria-label="Contents">
                    <h2 class="guide-contents__title">Contents</h2>
                    <ul class="guide-contents__list">
                        @foreach (var (title, id) in contentsItems)
                        {
                            <li class="guide-contents__item">
                                <span class="guide-contents__num" aria-hidden="true">—</span>
                                <a href="#@id">@title</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    }

    @* Content + sidebar (same structure as DetailedGuide) *@
    <div class="govuk-grid-row guide-content-row">
        <div class="@(hasRightPanel ? "govuk-grid-column-two-thirds" : "govuk-grid-column-full")">
            <section class="dfe-f-content-section guide-content-section" aria-label="Content">
        
                @if (!string.IsNullOrWhiteSpace(jobSpec.Profession?.ProfessionDescription))
                {
                    var professionLabel = (jobSpec.Profession?.Plural ?? jobSpec.Profession?.Title ?? "people").ToLowerInvariant();
                    <h2 id="profession-description-heading" class="govuk-heading-l">What @professionLabel do</h2>
                    <div class="dfe-f-body govuk-!-margin-bottom-8">
                        @Html.Raw(professionDescriptionHtml)
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(jobSpec.RoleDescription))
                {
                    <h2 id="you-will-heading" class="govuk-heading-l">Role responsibilities</h2>
                    <div class="dfe-f-body">
                        @Html.Raw(roleDescriptionHtml)
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(jobSpec.Skills))
                {
                    <h2 id="skills-heading" class="govuk-heading-l govuk-!-margin-top-8">Skills you need</h2>
                    <div class="dfe-f-body">
                        @Html.Raw(skillsHtml)
                    </div>
                }
            </section>
            @if (jobSpec.EnableWordDocDownload)
            {
               
                    <h2 class="govuk-heading-l">Downloads</h2>
                    <div class="dfe-f-document-list">
                        <div class="dfe-f-document-item">
                            <div class="dfe-f-document-item__icon">DOCX</div>
                            <div class="dfe-f-document-item__info">
                                <h4 class="govuk-heading-s dfe-f-document-item__title">
                                    <a class="govuk-link" href="/guidance/job-specifications/@jobSpec.Slug/download">@(jobSpec.Title ?? "Job description").docx</a>
                                </h4>
                                <p class="dfe-f-document-item__meta">Word document</p>
                            </div>
                        </div>
                    </div>
             
            }
        </div>

        @if (hasRightPanel)
        {
            <div class="govuk-grid-column-one-third">
                @if (jobSpec.SiblingJobSpecifications.Count > 0)
                {
                    <aside class="guide-sidebar__card" aria-label="Related content">
                        <div class="govuk-!-margin-bottom-4">
                            <h3>Other roles in this profession</h3>
                            <div class="govuk-body-s">
                                <ul class="govuk-list govuk-list--spaced govuk-body-s">
                                    @foreach (var sibling in jobSpec.SiblingJobSpecifications)
                                    {
                                        var isCurrent = sibling.Slug == jobSpec.Slug;
                                        <li>
                                            @if (isCurrent)
                                            {
                                                <span aria-current="page">@sibling.Title</span>
                                            }
                                            else
                                            {
                                                var siblingHref = "/guidance/job-specifications/" + sibling.Slug + (hasCollection ? "?collection=" + Uri.EscapeDataString(collectionSlug!) : "");
                                                <a class="govuk-link" href="@siblingHref">@sibling.Title</a>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </aside>
                }
               
            </div>
        }
    </div>
</div>

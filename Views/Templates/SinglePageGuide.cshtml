@using ServiceManual.Helpers
@using ServiceManual.Models
@{
    var guide = ViewBag.Guide as SinglePageGuide ?? new SinglePageGuide();
    var professionsTagsHtml = "";
    var bodyForRender = (guide.Body ?? "").Replace("[[professions]]", professionsTagsHtml);
    var bodyHtml = GovUkMarkdownHelper.ToGovUkHtmlForBody(bodyForRender);
    ViewData["Title"] = guide.Title;
    var guideTitle = guide.Title;
    var guideMetaDescription = guide.MetaDescription;
    var guideSlug = "";
    var siblingPages = new List<DetailedGuidePageSummary>();
    var collectionSlug = guide.CollectionSlug ?? "";
    var collectionTitle = guide.CollectionTitle ?? "";
    var guidePagesOnRightSide = false;
    var hideTitleAndDescription = true;
    var beforeContents = "";
    var hideContents = false;
    var pageTitle = guide.Title;
    var pageMetaDescription = guide.MetaDescription;
    var slug = guide.Slug;
    var relatedContent = guide.RelatedContent;
    var hasRightPanel = guidePagesOnRightSide || relatedContent.Count > 0 || guide.Collections.Count > 0;
    var pageHeadings = GovUkMarkdownHelper.ExtractHeadingsFromHtml(bodyHtml);
}

@section Breadcrumbs {
<li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="/">Home</a></li>
<li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="/guidance">Guidance</a></li>
@if (!string.IsNullOrEmpty(collectionSlug) && !string.IsNullOrEmpty(collectionTitle))
{
    <li class="govuk-breadcrumbs__list-item" aria-current="page">@collectionTitle</li>
}
}

@* Row 1: header + guide contents nav *@
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

        <div class="dfe-f-header">

        <span class="govuk-caption-xl  govuk-!-margin-top-5">Guidance</span>
            <h1 class="govuk-heading-xl dfe-f-header__title">@guideTitle</h1>
            @if (!string.IsNullOrEmpty(guideMetaDescription))
            {
                <p class="govuk-body-l dfe-f-header__intro">@guideMetaDescription</p>
            }
        </div>

        @if (!guidePagesOnRightSide && !hideTitleAndDescription && siblingPages.Count > 0 && !string.IsNullOrEmpty(guideTitle))
        {
            <nav class="dfe-f-guide-contents" aria-label="@guideTitle contents">
                <h2 class="dfe-f-guide-contents__title">Contents</h2>
                <ol class="dfe-f-guide-contents__list">
                    @foreach (var sibling in siblingPages)
                    {
                        var isCurrent = sibling.Slug == slug;
                        <li class="dfe-f-guide-contents__item dfe-f-guide-contents__item--dashed @(isCurrent ? "dfe-f-guide-contents__item--active" : "")">
                            <span class="dfe-f-guide-contents__dash" aria-hidden="true"></span>
                            @if (isCurrent)
                            {
                                <span aria-current="page">@sibling.Title</span>
                            }
                            else
                            {
                                <a class="govuk-link dfe-f-guide-contents__link" href="/guidance/guides/@guideSlug/@sibling.Slug">@sibling.Title</a>
                            }
                        </li>
                    }
                </ol>
            </nav>
        }

    </div>
</div>

@* Row 2: body content + right panel *@
<div class="govuk-grid-row govuk-!-margin-top-6">

    <div class="@(hasRightPanel ? "govuk-grid-column-two-thirds" : "govuk-grid-column-full")">

        @if (!hideTitleAndDescription)
        {
            <h2 class="govuk-heading-l">@pageTitle</h2>
            @if (!string.IsNullOrEmpty(pageMetaDescription))
            {
                <p class="govuk-body-l">@pageMetaDescription</p>
            }
        }

        @if (!string.IsNullOrWhiteSpace(beforeContents))
        {
            var beforeContentsForRender = beforeContents.Replace("[[professions]]", professionsTagsHtml);
            <div class="govuk-!-margin-bottom-6">
                @Html.Raw(GovUkMarkdownHelper.ToGovUkHtmlForBody(beforeContentsForRender))
            </div>
        }

        @if (!hideContents && pageHeadings.Count > 0)
        {
            <nav class="dfe-f-guide-contents" aria-label="On this page">
                <h2 class="dfe-f-guide-contents__title">Contents</h2>
                <ol class="dfe-f-guide-contents__list">
                    @foreach (var heading in pageHeadings)
                    {
                        <li class="dfe-f-guide-contents__item dfe-f-guide-contents__item--dashed @(heading.Level == 3 ? "dfe-f-guide-contents__item--indent" : "")">
                            <span class="dfe-f-guide-contents__dash" aria-hidden="true"></span>
                            <a class="govuk-link dfe-f-guide-contents__link" href="#@heading.Id">@heading.Text</a>
                        </li>
                    }
                </ol>
            </nav>
        }

        <div class="dfe-f-body">
            @Html.Raw(bodyHtml)
        </div>

        @if (siblingPages.Count > 1)
        {
            <nav class="govuk-pagination govuk-pagination--block" aria-label="Pages in this guide">
                @{
                    var currentIndex = siblingPages.FindIndex(p => p.Slug == slug);
                    var prevPage = currentIndex > 0 ? siblingPages[currentIndex - 1] : null;
                    var nextPage = currentIndex >= 0 && currentIndex < siblingPages.Count - 1 ? siblingPages[currentIndex + 1] : null;
                }
                @if (prevPage is not null)
                {
                    <div class="govuk-pagination__prev">
                        <a class="govuk-link govuk-pagination__link" href="/guidance/guides/@guideSlug/@prevPage.Slug" rel="prev">
                            <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" focusable="false" aria-hidden="true" viewBox="0 0 15 13"><path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.449-4.1856-3.9768h12.896v-2h-12.984l4.2931-4.293-1.414-1.414z"/></svg>
                            <span class="govuk-pagination__link-title">Previous<span class="govuk-visually-hidden"> page</span></span>
                            <span class="govuk-visually-hidden">:</span>
                            <span class="govuk-pagination__link-label">@prevPage.Title</span>
                        </a>
                    </div>
                }
                @if (nextPage is not null)
                {
                    <div class="govuk-pagination__next">
                        <a class="govuk-link govuk-pagination__link" href="/guidance/guides/@guideSlug/@nextPage.Slug" rel="next">
                            <span class="govuk-pagination__link-title">Next<span class="govuk-visually-hidden"> page</span></span>
                            <span class="govuk-visually-hidden">:</span>
                            <span class="govuk-pagination__link-label">@nextPage.Title</span>
                            <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" focusable="false" aria-hidden="true" viewBox="0 0 15 13"><path d="m8.107-0.0078125-1.4136 1.414 4.2926 4.293h-12.986v2h12.896l-4.1855 3.9766 1.377 1.4492 6.7441-6.4062-6.7246-6.7246z"/></svg>
                        </a>
                    </div>
                }
            </nav>
        }

    </div>

    @if (hasRightPanel)
    {
        <div class="govuk-grid-column-one-third">
            @if (guide.Collections.Count > 0)
            {
                <aside class="dfe-f-sidebar-box dfe-f-sidebar-box--highlight" aria-label="Part of">
                    <div class="dfe-f-sidebar-box__section">
                        <h3>Part of</h3>
                        <ul class="govuk-list govuk-list--spaced">
                            <li><a class="govuk-link" href="/guidance/collections/@guide.Collections[0].Slug"><strong>@guide.Collections[0].Title</strong></a></li>
                        </ul>
                    </div>
                    @if (guide.Collections.Count > 1)
                    {
                        <div class="dfe-f-sidebar-box__section">
                            <h3 class="govuk-!-font-weight-regular">Also part of</h3>
                            <ul class="govuk-list govuk-list--spaced">
                                @foreach (var c in guide.Collections.Skip(1))
                                {
                                    <li><a class="govuk-link" href="/guidance/collections/@c.Slug">@c.Title</a></li>
                                }
                            </ul>
                        </div>
                    }
                </aside>
            }

            @if (guidePagesOnRightSide && siblingPages.Count > 0)
            {
                <aside class="dfe-f-sidebar-box" aria-label="Pages in this guide">
                    <div class="dfe-f-sidebar-box__section">
                        <h3>Pages in this guide</h3>
                        <ol class="govuk-list govuk-list--spaced govuk-body-s">
                            @foreach (var sibling in siblingPages)
                            {
                                var isCurrent = sibling.Slug == slug;
                                <li class="govuk-!-margin-bottom-2 @(isCurrent ? "govuk-!-font-weight-bold" : "")">
                                    @if (isCurrent)
                                    {
                                        <span aria-current="page">@sibling.Title</span>
                                    }
                                    else
                                    {
                                        <a class="govuk-link" href="/guidance/guides/@guideSlug/@sibling.Slug">@sibling.Title</a>
                                    }
                                </li>
                            }
                        </ol>
                    </div>
                </aside>
            }

            @if (relatedContent.Count > 0)
            {
                <aside class="dfe-f-sidebar-box" aria-label="Related content">
                    @foreach (var item in relatedContent)
                    {
                        <div class="dfe-f-sidebar-box__section">
                            <h3>@Html.Raw(GovUkMarkdownHelper.ToGovUkInlineHtml(item.Header))</h3>
                            @if (!string.IsNullOrEmpty(item.Content))
                            {
                                <div class="govuk-body-s">
                                    @Html.Raw(GovUkMarkdownHelper.ToGovUkHtmlForRelatedContent(item.Content))
                                </div>
                            }
                        </div>
                    }
                </aside>
            }
        </div>
    }

</div>

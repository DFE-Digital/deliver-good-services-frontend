@using ServiceManual.Helpers
@using ServiceManual.Models
@{
    var guidePage = ViewBag.Page as DetailedGuidePage ?? new DetailedGuidePage();
    var professionsTagsHtml = "";
    if (guidePage.Professions.Count > 0)
    {
        var sb = new System.Text.StringBuilder();
        foreach (var p in guidePage.Professions)
        {
            sb.Append("<strong class=\"govuk-tag govuk-!-margin-right-2 govuk-!-margin-bottom-2\">");
            sb.Append(System.Net.WebUtility.HtmlEncode(p));
            sb.Append("</strong>");
        }
        professionsTagsHtml = sb.ToString();
    }
    var bodyForRender = (guidePage.Body ?? "").Replace("[[professions]]", professionsTagsHtml);
    var bodyHtml = GovUkMarkdownHelper.ToGovUkHtmlForBody(bodyForRender);
    ViewData["Title"] = guidePage.Title;
    var hasRightPanel = guidePage.RelatedContent.Count > 0 || guidePage.Collections.Count > 0;
}

@section Breadcrumbs {
<li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="/">Home</a></li>
<li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="/guidance">Guidance</a></li>
@if (!string.IsNullOrEmpty(guidePage.CollectionSlug) && !string.IsNullOrEmpty(guidePage.CollectionTitle))
{
    <li class="govuk-breadcrumbs__list-item" aria-current="page">@guidePage.CollectionTitle</li>
}
}

@* Row 1: header + guide contents nav *@
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

        <div class="dfe-f-header">

        <span class="govuk-caption-xl  govuk-!-margin-top-5">Guidance</span>
            <h1 class="govuk-heading-xl dfe-f-header__title">@guidePage.GuideTitle</h1>
            @if (!string.IsNullOrEmpty(guidePage.GuideMetaDescription))
            {
                <p class="govuk-body-l dfe-f-header__intro">@guidePage.GuideMetaDescription</p>
            }
        </div>

        @if (!guidePage.HideTitleAndDescription && guidePage.SiblingPages.Count > 0 && !string.IsNullOrEmpty(guidePage.GuideTitle))
        {
            <nav class="dfe-f-guide-contents" aria-label="@guidePage.GuideTitle contents">
                <h2 class="dfe-f-guide-contents__title">Contents</h2>
                <ul class="dfe-f-guide-contents__list">
                    @foreach (var sibling in guidePage.SiblingPages)
                    {
                        var isCurrent = sibling.Slug == guidePage.Slug;
                        <li class="dfe-f-guide-contents__item dfe-f-guide-contents__item--dashed @(isCurrent ? "dfe-f-guide-contents__item--active" : "")">
                            <span class="dfe-f-guide-contents__dash" aria-hidden="true"></span>
                            @if (isCurrent)
                            {
                                <span aria-current="page">@sibling.Title</span>
                            }
                            else
                            {
                                <a class="govuk-link dfe-f-guide-contents__link" href="/guidance/guides/@guidePage.GuideSlug/@sibling.Slug">@sibling.Title</a>
                            }
                        </li>
                    }
                </ul>
            </nav>
        }

    </div>
</div>

@* Row 2: body content + right panel (spacing from .dfe-f-guide-contents margin-bottom above) *@
<div class="govuk-grid-row">

    <div class="@(hasRightPanel ? "govuk-grid-column-two-thirds" : "govuk-grid-column-full")">

        @if (!guidePage.HideTitleAndDescription)
        {
            <h2 class="govuk-heading-l">@guidePage.Title</h2>
            @if (!string.IsNullOrEmpty(guidePage.MetaDescription))
            {
                <p class="govuk-body-l">@guidePage.MetaDescription</p>
            }
        }

        @if (!string.IsNullOrWhiteSpace(guidePage.BeforeContents))
        {
            var beforeContentsForRender = guidePage.BeforeContents.Replace("[[professions]]", professionsTagsHtml);
            <div class="govuk-!-margin-bottom-6">
                @Html.Raw(GovUkMarkdownHelper.ToGovUkHtmlForBody(beforeContentsForRender))
            </div>
        }

        <div class="dfe-f-body">
            @Html.Raw(bodyHtml)
        </div>

        @if (guidePage.SiblingPages.Count > 1)
        {
            <nav class="govuk-pagination govuk-pagination--block" aria-label="Pages in this guide">
                @{
                    var currentIndex = guidePage.SiblingPages.FindIndex(p => p.Slug == guidePage.Slug);
                    var prevPage = currentIndex > 0 ? guidePage.SiblingPages[currentIndex - 1] : null;
                    var nextPage = currentIndex >= 0 && currentIndex < guidePage.SiblingPages.Count - 1 ? guidePage.SiblingPages[currentIndex + 1] : null;
                }
                @if (prevPage is not null)
                {
                    <div class="govuk-pagination__prev">
                        <a class="govuk-link govuk-pagination__link" href="/guidance/guides/@guidePage.GuideSlug/@prevPage.Slug" rel="prev">
                            <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" focusable="false" aria-hidden="true" viewBox="0 0 15 13"><path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.449-4.1856-3.9768h12.896v-2h-12.984l4.2931-4.293-1.414-1.414z"/></svg>
                            <span class="govuk-pagination__link-title">Previous<span class="govuk-visually-hidden"> page</span></span>
                            <span class="govuk-visually-hidden">:</span>
                            <span class="govuk-pagination__link-label">@prevPage.Title</span>
                        </a>
                    </div>
                }
                @if (nextPage is not null)
                {
                    <div class="govuk-pagination__next">
                        <a class="govuk-link govuk-pagination__link" href="/guidance/guides/@guidePage.GuideSlug/@nextPage.Slug" rel="next">
                            <span class="govuk-pagination__link-title">Next<span class="govuk-visually-hidden"> page</span></span>
                            <span class="govuk-visually-hidden">:</span>
                            <span class="govuk-pagination__link-label">@nextPage.Title</span>
                            <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" focusable="false" aria-hidden="true" viewBox="0 0 15 13"><path d="m8.107-0.0078125-1.4136 1.414 4.2926 4.293h-12.986v2h12.896l-4.1855 3.9766 1.377 1.4492 6.7441-6.4062-6.7246-6.7246z"/></svg>
                        </a>
                    </div>
                }
            </nav>
        }

    </div>

    @if (hasRightPanel)
    {
        <div class="govuk-grid-column-one-third">
            @if (guidePage.Collections.Count > 0)
            {
                <aside class="dfe-f-sidebar-box dfe-f-sidebar-box--highlight" aria-label="Part of">
                    <div class="dfe-f-sidebar-box__section">
                        <h3>Part of</h3>
                        <ul class="govuk-list govuk-list--spaced">
                            <li><a class="govuk-link" href="/guidance/collections/@guidePage.Collections[0].Slug"><strong>@guidePage.Collections[0].Title</strong></a></li>
                        </ul>
                    </div>
                    @if (guidePage.Collections.Count > 1)
                    {
                        <div class="dfe-f-sidebar-box__section">
                            <h3 class="govuk-!-font-weight-regular govuk-!-margin-bottom-1">Also part of</h3>
                            <ul class="govuk-list govuk-list--spaced">
                                @foreach (var c in guidePage.Collections.Skip(1))
                                {
                                    <li><a class="govuk-link" href="/guidance/collections/@c.Slug">@c.Title</a></li>
                                }
                            </ul>
                        </div>
                    }
                </aside>
            }

            @if (guidePage.RelatedContent.Count > 0)
            {
                <aside class="dfe-f-sidebar-box" aria-label="Related content">
                    @foreach (var item in guidePage.RelatedContent)
                    {
                        <div class="dfe-f-sidebar-box__section">
                            <h3>@Html.Raw(GovUkMarkdownHelper.ToGovUkInlineHtml(item.Header))</h3>
                            @if (!string.IsNullOrEmpty(item.Content))
                            {
                                <div class="govuk-body-s">
                                    @Html.Raw(GovUkMarkdownHelper.ToGovUkHtmlForRelatedContent(item.Content))
                                </div>
                            }
                        </div>
                    }
                </aside>
            }
        </div>
    }

</div>

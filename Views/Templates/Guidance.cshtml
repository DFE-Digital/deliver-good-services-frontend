@model ServiceManual.Models.GuidanceIndexViewModel
@using Microsoft.AspNetCore.WebUtilities
@{

    @* Set the hero title and intro *@
    ViewBag.HeroType = "collection";
    ViewBag.HeroTitle = "Guidance for DfE digital, data and technology teams";
    ViewBag.HeroIntro = "Browse guidance by area — grouped around the disciplines and topics that matter to your team. Each area contains collections of guides, standards, patterns and tools.";
    ViewBag.UseInverseNav = true;

    string BuildFilterUrl(string? areaSlug, IEnumerable<string>? professionSlugs, string? searchTerm)
    {
        var query = new List<KeyValuePair<string, string?>>();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            query.Add(new KeyValuePair<string, string?>("search", searchTerm));
        }

        if (!string.IsNullOrWhiteSpace(areaSlug))
        {
            query.Add(new KeyValuePair<string, string?>("guidanceArea", areaSlug));
        }

        foreach (var professionSlug in professionSlugs ?? [])
        {
            if (!string.IsNullOrWhiteSpace(professionSlug))
            {
                query.Add(new KeyValuePair<string, string?>("professions", professionSlug));
            }
        }

        return query.Count == 0 ? "/guidance" : QueryHelpers.AddQueryString("/guidance", query);
    }
}

<div class="guide-modern guidance-index">
    @await Html.PartialAsync("~/Views/Shared/_HeroSection.cshtml")

    <div class="guidance-body">
        <div class="govuk-grid-row">
            <aside class="govuk-grid-column-one-third guidance-filters" aria-label="Filter guidance">
                <div class="gf-block">
                    <span class="gf-title">Search this page</span>
                    <form method="get" action="/guidance" class="gf-search" role="search">
                        @if (!string.IsNullOrWhiteSpace(Model.SelectedGuidanceAreaSlug))
                        {
                            <input type="hidden" name="guidanceArea" value="@Model.SelectedGuidanceAreaSlug" />
                        }
                        @foreach (var professionSlug in Model.SelectedProfessionSlugs)
                        {
                            <input type="hidden" name="professions" value="@professionSlug" />
                        }
                        <label class="govuk-label govuk-visually-hidden" for="guidance-search">Search guidance</label>
                        <input class="govuk-input" id="guidance-search" name="search" type="text" value="@Model.SelectedSearchTerm" placeholder="Search guidance" autocomplete="off" />
                        <div class="guidance-filters__actions gf-search__actions">
                            <button type="submit" class="govuk-button govuk-button--secondary guidance-filters__button">Search</button>
                        </div>
                    </form>
                </div>

                <div class="gf-block guidance-filters__divider">
                    <span class="gf-title">Filter by area</span>
                    <ul class="gf-list">
                        <li class="gf-item">
                            <a class="gf-link @(string.IsNullOrWhiteSpace(Model.SelectedGuidanceAreaSlug) ? "active" : null)" href="@BuildFilterUrl(null, Model.SelectedProfessionSlugs, Model.SelectedSearchTerm)">
                                <span class="gf-dot"></span>
                                All areas
                                <span class="gf-count">@Model.TotalCollectionCount</span>
                            </a>
                        </li>
                        @foreach (var area in Model.AreaFilters)
                        {
                            <li class="gf-item">
                                <a class="gf-link @(Model.SelectedGuidanceAreaSlug == area.Slug ? "active" : null)" href="@BuildFilterUrl(area.Slug, Model.SelectedProfessionSlugs, Model.SelectedSearchTerm)">
                                    <span class="gf-dot"></span>
                                    @area.Label
                                    <span class="gf-count">@area.Count</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>

                <div class="gf-block guidance-filters__divider">
                    <span class="gf-title">Filter by profession</span>
                    <form method="get" action="/guidance">
                        @if (!string.IsNullOrWhiteSpace(Model.SelectedSearchTerm))
                        {
                            <input type="hidden" name="search" value="@Model.SelectedSearchTerm" />
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.SelectedGuidanceAreaSlug))
                        {
                            <input type="hidden" name="guidanceArea" value="@Model.SelectedGuidanceAreaSlug" />
                        }

                        <ul class="gf-list">
                            @foreach (var profession in Model.ProfessionFilters)
                            {
                                <li class="gf-item">
                                    <label class="gf-check">
                                        <input type="checkbox" name="professions" value="@profession.Slug" checked="@(Model.SelectedProfessionSlugs.Contains(profession.Slug) ? "checked" : null)" />
                                        <span class="gf-check__lbl">@profession.Label</span>
                                        <span class="gf-count">@profession.Count</span>
                                    </label>
                                </li>
                            }
                        </ul>

                        <div class="guidance-filters__actions">
                            <button type="submit" class="govuk-button govuk-button--secondary guidance-filters__button">Apply filters</button>
                            @if (Model.HasActiveFilters)
                            {
                                <a class="govuk-link guidance-filters__clear" href="/guidance">Clear all filters</a>
                            }
                        </div>
                    </form>
                </div>
            </aside>

            <div class="govuk-grid-column-two-thirds guidance-main">
                @if (Model.Areas.Count == 0)
                {
                    <div class="guidance-empty-state">
                        <h2 class="govuk-heading-m">No guidance matches those filters</h2>
                        <p class="govuk-body">Try clearing one or more filters to see more collections.</p>
                        <p class="govuk-body"><a class="govuk-link" href="/guidance">View all guidance</a></p>
                    </div>
                }
                else
                {
                    @foreach (var area in Model.Areas)
                    {
                        <section class="ga-section" id="area-@area.Slug" data-area="@area.Slug" aria-labelledby="ga-@area.Slug-hd">
                            <div class="ga-header" style="--ga-c:@area.ColourHex">
                                <div class="ga-header__mark"></div>
                                <div class="ga-header__body">
                                    <div class="ga-header__top">
                                        <h2 class="ga-header__title" id="ga-@area.Slug-hd">@area.Name</h2>
                                        <span class="ga-header__count">@area.TotalItemCount item@(area.TotalItemCount == 1 ? null : "s") across @area.CollectionCount card@(area.CollectionCount == 1 ? null : "s")</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(area.IntroText))
                                    {
                                        <p class="ga-header__desc">@area.IntroText</p>
                                    }
                                    @if (area.FeaturedProfessions.Count > 0)
                                    {
                                        <div class="ga-header__profs">
                                            @foreach (var profession in area.FeaturedProfessions)
                                            {
                                                <span class="ga-prof">@profession.Title</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="ga-collections">
                                @foreach (var collection in area.Collections)
                                {
                                    <a class="ga-coll" href="@collection.Url">
                                        <div class="ga-coll__top">
                                            <span class="ga-coll__name">@collection.Title</span>
                                        </div>
                                        <p class="ga-coll__desc">@collection.Description</p>
                                        @if (collection.ContentType == "Collection" || collection.ContentType == "Detailed guide" || collection.AlsoInAreas.Count > 0)
                                        {
                                            <div class="ga-coll__tags">
                                                @if (collection.ContentType == "Collection")
                                                {
                                                    <span class="ga-coll__tag">Collection</span>
                                                }
                                                else if (collection.ContentType == "Detailed guide")
                                                {
                                                    <span class="ga-coll__tag">Guide</span>
                                                }
                                                @if (collection.AlsoInAreas.Count > 0)
                                                {
                                                    <span class="ga-coll__also">Also in: @string.Join(", ", collection.AlsoInAreas.Select(areaRef => areaRef.Title))</span>
                                                }
                                            </div>
                                        }
                                    </a>
                                }
                            </div>
                        </section>
                    }
                }
            </div>
        </div>
    </div>
</div>

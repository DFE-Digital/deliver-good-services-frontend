@{
    ViewData["Title"] = "Home";
}

@section Masthead {
<div class="homepage-hero">
    <div class="govuk-width-container">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
                <h1 class="govuk-heading-xl">
                    Deliver good services
                </h1>
                <p class="govuk-body-l homepage-hero__intro">
                    Your single entry point for standards, guidance and manuals to design, build and run consistent, accessible, user-centred digital services in the Department for Education.
                </p>
                <p class="govuk-body homepage-hero__meta">
                    Find the Service Standard, design and technical guidance, DDT standards, and how to document and improve your services.
                </p>
            </div>
        </div>
    </div>
</div>
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <div class="dfe-cta-section">
                <h2 class="dfe-cta-section__heading">We're consolidating all our manuals and guidance</h2>
                <p class="dfe-cta-section__text">
                    We're working on consolidating all our existing manuals and guidance into one single resource for all digital, data, and tech delivery in DfE. Find out about this work and how to get involved.
                </p>
                <a href="/about" class="govuk-button dfe-cta-section__button">Find out more <span class="govuk-visually-hidden">about the Service Manual project</span></a>
            </div>
        </div>
    </div>

    <section class="homepage-section homepage-section--start-here" aria-labelledby="start-here-heading">
        <h2 id="start-here-heading" class="govuk-heading-l govuk-!-margin-bottom-6">Start here</h2>
        <p class="govuk-body govuk-!-margin-bottom-6">Quick access to the most used standards and guidance:</p>
        <ul class="dfe-action-list govuk-!-margin-bottom-0">
            <li>
                <a href="https://apply-the-service-standard.education.gov.uk/" target="_blank" rel="noopener noreferrer">
                    Apply the Service Standard
                    <svg class="chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
            </li>
            <li>
                <a href="https://standards.education.gov.uk/" target="_blank" rel="noopener noreferrer">
                    Find and use standards
                    <svg class="chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
            </li>
            <li>
                <a href="https://design.education.gov.uk/" target="_blank" rel="noopener noreferrer">
                    Design Manual
                    <svg class="chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
            </li>
            <li>
                <a href="https://technical-guidance.education.gov.uk/" target="_blank" rel="noopener noreferrer">
                    Technical guidance
                    <svg class="chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
            </li>
        </ul>
    </section>

    <section class="homepage-section" aria-labelledby="manuals-heading">
        <h2 id="manuals-heading" class="govuk-heading-l govuk-!-margin-bottom-6">Manuals and guidance</h2>
        <p class="govuk-body govuk-!-margin-bottom-6">All our manuals and guidance, grouped by topic. Use these to access standards, design and technical guidance, and ways of working.</p>

        <h3 class="govuk-heading-m govuk-!-margin-top-8 govuk-!-margin-bottom-4">Standards and assessment</h3>
        <ul class="dfe-chevron-card__list">
            <li class="dfe-chevron-card">
                <a href="https://apply-the-service-standard.education.gov.uk/" class="govuk-link dfe-chevron-card__link" target="_blank" rel="noopener noreferrer">
                    <div class="dfe-chevron-card__wrapper">
                        <h4 class="govuk-heading-s dfe-chevron-card__heading">Apply the Service Standard</h4>
                        <p class="dfe-chevron-card__description">
                            Guidance for applying the Government Service Standard to design and build accessible, usable services in DfE.
                        </p>
                    </div>
                </a>
            </li>
            <li class="dfe-chevron-card">
                <a href="https://standards.education.gov.uk/" class="govuk-link dfe-chevron-card__link" target="_blank" rel="noopener noreferrer">
                    <div class="dfe-chevron-card__wrapper">
                        <h4 class="govuk-heading-s dfe-chevron-card__heading">Find and Use Standards</h4>
                        <p class="dfe-chevron-card__description">
                            Digital, data and technology standards to support good service delivery in DfE.
                        </p>
                    </div>
                </a>
            </li>
        </ul>

        <h3 class="govuk-heading-m govuk-!-margin-top-8 govuk-!-margin-bottom-4">Design and accessibility</h3>
        <ul class="dfe-chevron-card__list">
            <li class="dfe-chevron-card">
                <a href="https://design.education.gov.uk/" class="govuk-link dfe-chevron-card__link" target="_blank" rel="noopener noreferrer">
                    <div class="dfe-chevron-card__wrapper">
                        <h4 class="govuk-heading-s dfe-chevron-card__heading">Design Manual</h4>
                        <p class="dfe-chevron-card__description">
                            Standards and guidance to help you design consistent, accessible, user-centred products and services in DfE.
                        </p>
                    </div>
                </a>
            </li>
            <li class="dfe-chevron-card">
                <a href="https://accessibility.education.gov.uk/" class="govuk-link dfe-chevron-card__link" target="_blank" rel="noopener noreferrer">
                    <div class="dfe-chevron-card__wrapper">
                        <h4 class="govuk-heading-s dfe-chevron-card__heading">Accessibility and Inclusive Design Manual</h4>
                        <p class="dfe-chevron-card__description">
                            Standards and guidance for designing and building accessible and inclusive products and services.
                        </p>
                    </div>
                </a>
            </li>
        </ul>

        <h3 class="govuk-heading-m govuk-!-margin-top-8 govuk-!-margin-bottom-4">Technical and architecture</h3>
        <ul class="dfe-chevron-card__list">
            <li class="dfe-chevron-card">
                <a href="https://technical-guidance.education.gov.uk/" class="govuk-link dfe-chevron-card__link" target="_blank" rel="noopener noreferrer">
                    <div class="dfe-chevron-card__wrapper">
                        <h4 class="govuk-heading-s dfe-chevron-card__heading">Technical Guidance</h4>
                        <p class="dfe-chevron-card__description">
                            Technical standards and guidance for building digital services, with tools and patterns for code reuse and consistency.
                        </p>
                    </div>
                </a>
            </li>
            <li class="dfe-chevron-card">
                <a href="https://dfe-digital.github.io/architecture/#dfe-architecture" class="govuk-link dfe-chevron-card__link" target="_blank" rel="noopener noreferrer">
                    <div class="dfe-chevron-card__wrapper">
                        <h4 class="govuk-heading-s dfe-chevron-card__heading">Architecture</h4>
                        <p class="dfe-chevron-card__description">
                            Architecture principles, standards and guidance for designing services within DfE.
                        </p>
                    </div>
                </a>
            </li>
        </ul>

        <h3 class="govuk-heading-m govuk-!-margin-top-8 govuk-!-margin-bottom-4">Research and design history</h3>
        <ul class="dfe-chevron-card__list">
            <li class="dfe-chevron-card">
                <a href="https://user-research.education.gov.uk/" class="govuk-link dfe-chevron-card__link" target="_blank" rel="noopener noreferrer">
                    <div class="dfe-chevron-card__wrapper">
                        <h4 class="govuk-heading-s dfe-chevron-card__heading">User Research Manual</h4>
                        <p class="dfe-chevron-card__description">
                            Standards, principles, guidance and support for user researchers working in DfE.
                        </p>
                    </div>
                </a>
            </li>
            <li class="dfe-chevron-card">
                <a href="https://design-histories.education.gov.uk/" class="govuk-link dfe-chevron-card__link" target="_blank" rel="noopener noreferrer">
                    <div class="dfe-chevron-card__wrapper">
                        <h4 class="govuk-heading-s dfe-chevron-card__heading">Design Histories</h4>
                        <p class="dfe-chevron-card__description">
                            Find out how our services change over time with design histories documenting our design decisions.
                        </p>
                    </div>
                </a>
            </li>
        </ul>

        <h3 class="govuk-heading-m govuk-!-margin-top-8 govuk-!-margin-bottom-4">People and roles</h3>
        <ul class="dfe-chevron-card__list">
            <li class="dfe-chevron-card">
                <a href="https://job-descriptions.education.gov.uk/" class="govuk-link dfe-chevron-card__link" target="_blank" rel="noopener noreferrer">
                    <div class="dfe-chevron-card__wrapper">
                        <h4 class="govuk-heading-s dfe-chevron-card__heading">Find a Job Description</h4>
                        <p class="dfe-chevron-card__description">
                            Find and use job descriptions for Digital, Data, and Technology professions in DfE.
                        </p>
                    </div>
                </a>
            </li>
        </ul>
    </section>
</div>



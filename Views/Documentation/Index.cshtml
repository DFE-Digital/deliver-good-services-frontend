@using ServiceManual.Models
@{
  ViewData["Title"] = "Documentation";
  var sections = ViewData["DocSections"] as List<DocumentationSection> ?? new List<DocumentationSection>();
}

@section Styles {
  <link rel="stylesheet" href="~/css/documentation.css" asp-append-version="true" />
}

@section Breadcrumbs {
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="/">Home</a></li>
  <li class="govuk-breadcrumbs__list-item" aria-current="page">Documentation</li>
}

@section Scripts {
  <script src="/js/documentation.js"></script>
}

<div class="doc-wrapper">
  <div class="doc-layout">
    @await Html.PartialAsync("~/Views/Documentation/_DocNavSections.cshtml")
    @await Html.PartialAsync("~/Views/Documentation/_DocSideNav.cshtml")
    <main class="doc-content" id="main-content">
      <div class="doc-content__header">
        <h1 class="govuk-heading-l doc-content__title">Documentation</h1>
        <p class="doc-content__lead">Use the section tabs above to jump to a topic, then the side nav for specific pages. No secrets or environment-specific values are stored in this documentation.</p>
      </div>
      <div class="doc-note">
        <p class="govuk-body" style="margin:0">Content is managed in the CMS. Each section contains pages that appear in the left-hand navigation.</p>
      </div>
      @if (sections.Count > 0)
      {
        <div class="doc-card-grid" style="margin-top: 32px;">
          @foreach (var sec in sections)
          {
            <a href="/documentation/@sec.Slug" class="doc-card">
              <span class="doc-card__category">Section</span>
              <h3 class="doc-card__title">@sec.Title</h3>
              <p class="doc-card__description">@(sec.Documentations.Count) page@(sec.Documentations.Count == 1 ? "" : "s") in this section.</p>
            </a>
          }
        </div>
      }
      else
      {
        <p class="govuk-body" style="margin-top: 24px;">No documentation sections are available. Enable sections in the CMS.</p>
      }
    </main>
  </div>
</div>

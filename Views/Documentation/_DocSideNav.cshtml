@* Left-hand nav: list of pages in the current documentation section (from CMS) *@
@using ServiceManual.Models
@{
  var currentPath = Context.Request.Path.Value?.TrimEnd('/') ?? "";
  var pathSegments = currentPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
  var currentSectionSlug = pathSegments.Length >= 2 ? pathSegments[1] : "";
  var currentPageSlug = pathSegments.Length >= 3 ? string.Join("/", pathSegments.Skip(2)) : "";
  var section = ViewData["DocSection"] as DocumentationSection;
  var pages = ViewData["DocPages"] as List<DocumentationPageSummary> ?? new List<DocumentationPageSummary>();
  var sectionTitle = section?.Title ?? "Documentation";
}

@functions {
  bool IsActive(string sectionSlug, string pageSlug, string currentSection, string currentPage) =>
    string.Equals(sectionSlug, currentSection, StringComparison.OrdinalIgnoreCase) &&
    (string.IsNullOrEmpty(pageSlug) ? string.IsNullOrEmpty(currentPage) : string.Equals(pageSlug, currentPage, StringComparison.OrdinalIgnoreCase));
}

<nav class="doc-nav" aria-label="Section navigation">
  <p class="doc-nav__heading">@sectionTitle</p>
  <ul class="doc-nav__list">
    <li class="doc-nav__item">
      <a class="doc-nav__link @(string.IsNullOrEmpty(currentSectionSlug) && currentPath.TrimEnd('/') == "/documentation" ? "doc-nav__link--active" : "")" href="@(string.IsNullOrEmpty(currentSectionSlug) ? "/documentation" : $"/documentation/{currentSectionSlug}")">Overview</a>
    </li>
    @foreach (var page in pages)
    {
      var isActive = IsActive(currentSectionSlug, page.Slug, currentSectionSlug, currentPageSlug);
      <li class="doc-nav__item">
        <a class="doc-nav__link @(isActive ? "doc-nav__link--active" : "")" href="/documentation/@currentSectionSlug/@page.Slug">@page.Title</a>
      </li>
    }
  </ul>
</nav>

@{
  ViewData["Title"] = "Colour – Documentation";
}

@section Styles {
  <link rel="stylesheet" href="~/css/documentation.css" asp-append-version="true" />
}

@section Breadcrumbs {
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="/">Home</a></li>
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="/documentation">Documentation</a></li>
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="/documentation/styles">Styles</a></li>
  <li class="govuk-breadcrumbs__list-item" aria-current="page">Colour</li>
}

@section Scripts {
  <script src="/js/documentation.js"></script>
}

@{
  // Helper: render a swatch cell
  string Swatch(string hex, bool dark = false) {
    var border = dark ? "border:1px solid #b1b4b6;" : "border:1px solid #b1b4b6;";
    return $"<span style=\"display:inline-block;width:20px;height:20px;background:{hex};{border}vertical-align:middle;margin-right:8px\"></span>";
  }
}

<div class="doc-wrapper">
  <div class="doc-layout">
    @await Html.PartialAsync("~/Views/Documentation/_DocNavSections.cshtml")
    @await Html.PartialAsync("~/Views/Documentation/_DocSideNav.cshtml")
    <main class="doc-content" id="main-content">
    <div class="doc-content__header">
      <span class="doc-content__tag">Styles</span>
      <h1 class="govuk-heading-l doc-content__title">Colour</h1>
      <p class="doc-content__lead">The GOV.UK colour palette and how colours are used across the Service Manual — including text, backgrounds, borders, and component accents.</p>
    </div>

    <div class="doc-note">
      <p class="govuk-body" style="margin:0">Always use colours from the <a href="https://design-system.service.gov.uk/styles/colour/" class="govuk-link" rel="noopener noreferrer">GOV.UK colour palette</a>. Do not introduce custom colours. All colour combinations must meet <a href="https://www.w3.org/WAI/WCAG22/Understanding/contrast-minimum.html" class="govuk-link" rel="noopener noreferrer">WCAG 2.2 AA contrast requirements</a> — a minimum ratio of 4.5:1 for normal text.</p>
    </div>

    <!-- ── Functional colours ── -->
    <section class="doc-section">
      <h2 class="doc-section__title">Functional colours</h2>
      <p class="govuk-body doc-section__description">These colours are assigned by purpose. Use <code class="doc-inline-code">var(--govuk-colour-*)</code> CSS custom properties rather than copying hex values directly.</p>

      <table class="doc-table">
        <thead>
          <tr><th>Token</th><th>Hex</th><th>Purpose</th></tr>
        </thead>
        <tbody>
          <tr><td>@Html.Raw(Swatch("#0b0c0c"))<code class="doc-inline-code">--govuk-colour-text</code></td><td><code class="doc-inline-code">#0b0c0c</code></td><td>Primary text</td></tr>
          <tr><td>@Html.Raw(Swatch("#484949"))<code class="doc-inline-code">--govuk-colour-secondary-text</code></td><td><code class="doc-inline-code">#484949</code></td><td>Secondary / hint text</td></tr>
          <tr><td>@Html.Raw(Swatch("#1a65a6"))<code class="doc-inline-code">--govuk-colour-link</code></td><td><code class="doc-inline-code">#1a65a6</code></td><td>Link colour</td></tr>
          <tr><td>@Html.Raw(Swatch("#0f385c"))<code class="doc-inline-code">--govuk-colour-link-hover</code></td><td><code class="doc-inline-code">#0f385c</code></td><td>Link hover</td></tr>
          <tr><td>@Html.Raw(Swatch("#54319f"))<code class="doc-inline-code">--govuk-colour-link-visited</code></td><td><code class="doc-inline-code">#54319f</code></td><td>Visited link</td></tr>
          <tr><td>@Html.Raw(Swatch("#0b0c0c"))<code class="doc-inline-code">--govuk-colour-link-active</code></td><td><code class="doc-inline-code">#0b0c0c</code></td><td>Active link</td></tr>
          <tr><td>@Html.Raw(Swatch("#cecece"))<code class="doc-inline-code">--govuk-colour-border</code></td><td><code class="doc-inline-code">#cecece</code></td><td>Default border</td></tr>
          <tr><td>@Html.Raw(Swatch("#0b0c0c"))<code class="doc-inline-code">--govuk-colour-input-border</code></td><td><code class="doc-inline-code">#0b0c0c</code></td><td>Input border</td></tr>
          <tr><td>@Html.Raw(Swatch("#ffdd00"))<code class="doc-inline-code">--govuk-colour-focus</code></td><td><code class="doc-inline-code">#ffdd00</code></td><td>Focus ring</td></tr>
          <tr><td>@Html.Raw(Swatch("#ca3535"))<code class="doc-inline-code">--govuk-colour-error</code></td><td><code class="doc-inline-code">#ca3535</code></td><td>Error messages</td></tr>
          <tr><td>@Html.Raw(Swatch("#0f7a52"))<code class="doc-inline-code">--govuk-colour-success</code></td><td><code class="doc-inline-code">#0f7a52</code></td><td>Success messages</td></tr>
          <tr><td>@Html.Raw(Swatch("#1d70b8"))<code class="doc-inline-code">--govuk-colour-brand</code></td><td><code class="doc-inline-code">#1d70b8</code></td><td>Brand / GOV.UK blue</td></tr>
          <tr><td>@Html.Raw(Swatch("#f4f8fb"))<code class="doc-inline-code">--govuk-colour-template-bg</code></td><td><code class="doc-inline-code">#f4f8fb</code></td><td>Page template background</td></tr>
          <tr><td>@Html.Raw(Swatch("#ffffff"))<code class="doc-inline-code">--govuk-colour-body-bg</code></td><td><code class="doc-inline-code">#ffffff</code></td><td>Body background</td></tr>
        </tbody>
      </table>
    </section>

    <!-- ── GOV.UK web palette ── -->
    <section class="doc-section">
      <h2 class="doc-section__title">GOV.UK web palette</h2>
      <p class="govuk-body doc-section__description">
        The full web palette including primary, tints (25%, 50%, 80%, 95%) and shades (25%, 50%) for each colour group.
        All values are available as CSS custom properties — e.g. <code class="doc-inline-code">var(--govuk-colour-blue-tint-80)</code>.
      </p>

      @{
        // Each group: (groupName, cssPrefix, rows: (variantLabel, hex))
        var groups = new (string Name, string Prefix, (string Label, string Hex)[] Rows)[]
        {
          ("Blue", "blue", new[] {
            ("Primary",   "#1d70b8"),
            ("Tint 25%",  "#5694ca"),
            ("Tint 50%",  "#8eb8dc"),
            ("Tint 80%",  "#d2e2f1"),
            ("Tint 95%",  "#f4f8fb"),
            ("Shade 25%", "#16548a"),
            ("Shade 50%", "#0f385c"),
          }),
          ("Green", "green", new[] {
            ("Primary",   "#0f7a52"),
            ("Tint 25%",  "#4b9b7d"),
            ("Tint 50%",  "#87bca8"),
            ("Tint 80%",  "#cfe4dc"),
            ("Tint 95%",  "#f3f8f6"),
            ("Shade 25%", "#0b5c3e"),
            ("Shade 50%", "#083d29"),
          }),
          ("Teal", "teal", new[] {
            ("Primary",   "#158187"),
            ("Tint 25%",  "#50a1a5"),
            ("Tint 50%",  "#8ac0c3"),
            ("Tint 80%",  "#d0e6e7"),
            ("Tint 95%",  "#f3f9f9"),
            ("Shade 25%", "#106165"),
            ("Shade 50%", "#0b4144"),
            ("Accent",    "#00ffe0"),
          }),
          ("Purple", "purple", new[] {
            ("Primary",   "#54319f"),
            ("Tint 25%",  "#7f65b7"),
            ("Tint 50%",  "#aa98cf"),
            ("Tint 80%",  "#ddd6ec"),
            ("Tint 95%",  "#f6f5fa"),
            ("Shade 25%", "#3f2577"),
            ("Shade 50%", "#2a1950"),
          }),
          ("Magenta", "magenta", new[] {
            ("Primary",   "#ca357c"),
            ("Tint 25%",  "#d7689d"),
            ("Tint 50%",  "#e59abe"),
            ("Tint 80%",  "#f4d7e5"),
            ("Tint 95%",  "#fcf5f8"),
            ("Shade 25%", "#98285d"),
            ("Shade 50%", "#651b3e"),
          }),
          ("Red", "red", new[] {
            ("Primary",   "#ca3535"),
            ("Tint 25%",  "#d76868"),
            ("Tint 50%",  "#e59a9a"),
            ("Tint 80%",  "#f4d7d7"),
            ("Tint 95%",  "#fcf5f5"),
            ("Shade 25%", "#982828"),
            ("Shade 50%", "#651b1b"),
          }),
          ("Orange", "orange", new[] {
            ("Primary",   "#f47738"),
            ("Tint 25%",  "#f7996a"),
            ("Tint 50%",  "#fabb9c"),
            ("Tint 80%",  "#fde4d7"),
            ("Tint 95%",  "#fef8f5"),
            ("Shade 25%", "#b7592a"),
            ("Shade 50%", "#7a3c1c"),
          }),
          ("Yellow", "yellow", new[] {
            ("Primary",   "#ffdd00"),
            ("Tint 25%",  "#ffe640"),
            ("Tint 50%",  "#ffee80"),
            ("Tint 80%",  "#fff8cc"),
            ("Tint 95%",  "#fffdf2"),
            ("Shade 25%", "#bfa600"),
            ("Shade 50%", "#806f00"),
          }),
          ("Brown", "brown", new[] {
            ("Primary",   "#99704a"),
            ("Tint 25%",  "#b39477"),
            ("Tint 50%",  "#ccb8a5"),
            ("Tint 95%",  "#faf8f6"),
          }),
          ("Black", "black", new[] {
            ("Primary",   "#0b0c0c"),
            ("Tint 25%",  "#484949"),
            ("Tint 50%",  "#858686"),
            ("Tint 80%",  "#cecece"),
            ("Tint 95%",  "#f3f3f3"),
          }),
          ("White", "white", new[] {
            ("Primary",   "#ffffff"),
          }),
        };

        string CssVar(string prefix, string label) {
          if (label == "Primary") return $"--govuk-colour-{prefix}";
          if (label == "Accent")  return $"--govuk-colour-{prefix}-accent";
          // "Tint 25%" -> "tint-25", "Shade 50%" -> "shade-50"
          var slug = label.ToLower().Replace("%", "").Trim().Replace(" ", "-");
          return $"--govuk-colour-{prefix}-{slug}";
        }
      }

      @foreach (var group in groups)
      {
        <h3 class="govuk-heading-s" style="margin-top:24px;margin-bottom:8px">@group.Name</h3>
        <div class="doc-example" style="margin-bottom:24px">
          <p class="doc-example__label">Swatches</p>
          <div class="doc-example__preview" style="display:flex;flex-wrap:wrap;gap:8px;align-items:flex-end">
            @foreach (var row in group.Rows)
            {
              <div style="display:flex;flex-direction:column;align-items:center;gap:4px;min-width:64px">
                <div style="width:48px;height:48px;background:@row.Hex;border:1px solid #b1b4b6"></div>
                <span class="govuk-body-s" style="text-align:center;color:#505a5f;font-size:11px;line-height:1.3">@row.Label</span>
                <code class="doc-inline-code" style="font-size:10px">@row.Hex</code>
              </div>
            }
          </div>
        </div>
        <table class="doc-table" style="margin-bottom:0">
          <thead>
            <tr><th>Variant</th><th>CSS custom property</th><th>Hex</th></tr>
          </thead>
          <tbody>
            @foreach (var row in group.Rows)
            {
              <tr>
                <td>@row.Label</td>
                <td><code class="doc-inline-code">var(@CssVar(group.Prefix, row.Label))</code></td>
                <td><code class="doc-inline-code">@row.Hex</code></td>
              </tr>
            }
          </tbody>
        </table>
      }
    </section>

    <!-- ── Component accent colours ── -->
    <section class="doc-section">
      <h2 class="doc-section__title">Component accent colours</h2>
      <p class="govuk-body doc-section__description">These colours are used as accent borders and tag backgrounds in the <a href="/documentation/panel-component" class="govuk-link" rel="noopener noreferrer">Panel component</a> and <a href="/documentation/pill-component" class="govuk-link" rel="noopener noreferrer">Pill component</a>. Each maps to a named colour variant.</p>

      <div class="doc-example">
        <p class="doc-example__label">Preview</p>
        <div class="doc-example__preview" style="display:flex;flex-wrap:wrap;gap:8px">
          @foreach (var swatch in new[] {
            ("blue",   "#1d70b8", "Blue"),
            ("green",  "#00703c", "Green"),
            ("orange", "#f47738", "Orange"),
            ("red",    "#d4351c", "Red"),
            ("yellow", "#ffdd00", "Yellow"),
            ("grey",   "#b1b4b6", "Grey"),
            ("black",  "#0b0c0c", "Black"),
          })
          {
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:72px">
              <div style="width:48px;height:48px;background:@swatch.Item2;border:1px solid #b1b4b6"></div>
              <span class="govuk-body-s" style="text-align:center;color:#505a5f">@swatch.Item3</span>
              <code class="doc-inline-code" style="font-size:11px">@swatch.Item1</code>
            </div>
          }
        </div>
      </div>

      <table class="doc-table">
        <thead>
          <tr><th>Variant name</th><th>Hex</th><th>Use for</th></tr>
        </thead>
        <tbody>
          <tr><td><code class="doc-inline-code">blue</code></td><td><code class="doc-inline-code">#1d70b8</code></td><td>General requirements, standards, architecture</td></tr>
          <tr><td><code class="doc-inline-code">green</code></td><td><code class="doc-inline-code">#00703c</code></td><td>Accessibility, positive outcomes, completed items</td></tr>
          <tr><td><code class="doc-inline-code">orange</code></td><td><code class="doc-inline-code">#f47738</code></td><td>Warnings, items needing attention</td></tr>
          <tr><td><code class="doc-inline-code">red</code></td><td><code class="doc-inline-code">#d4351c</code></td><td>Critical requirements, blockers, failures</td></tr>
          <tr><td><code class="doc-inline-code">yellow</code></td><td><code class="doc-inline-code">#ffdd00</code></td><td>Cautions, in-progress items</td></tr>
          <tr><td><code class="doc-inline-code">grey</code></td><td><code class="doc-inline-code">#b1b4b6</code></td><td>Informational, optional, or low-priority items</td></tr>
          <tr><td><code class="doc-inline-code">black</code></td><td><code class="doc-inline-code">#0b0c0c</code></td><td>High-emphasis items</td></tr>
        </tbody>
      </table>
    </section>

    <!-- ── Phase colours ── -->
    <section class="doc-section">
      <h2 class="doc-section__title">Phase colours</h2>
      <p class="govuk-body doc-section__description">Fixed colours for service delivery phases. These are used in phase pills and the <code class="doc-inline-code">phases</code> attribute of the Panel component. Do not use these colours for other purposes.</p>

      <div class="doc-example">
        <p class="doc-example__label">Preview</p>
        <div class="doc-example__preview" style="display:flex;flex-wrap:wrap;gap:8px;align-items:center">
          <span class="dfe-pill dfe-pill--discovery">Discovery</span>
          <span class="dfe-pill dfe-pill--alpha">Alpha</span>
          <span class="dfe-pill dfe-pill--beta">Beta</span>
          <span class="dfe-pill dfe-pill--live">Live</span>
        </div>
      </div>

      <table class="doc-table">
        <thead>
          <tr><th>Phase</th><th>Background</th><th>Text</th><th>Border</th></tr>
        </thead>
        <tbody>
          <tr>
            <td><span class="dfe-pill dfe-pill--discovery">Discovery</span></td>
            <td><code class="doc-inline-code">#e8f0f8</code></td>
            <td><code class="doc-inline-code">#003a69</code></td>
            <td><code class="doc-inline-code">#b3c9e0</code></td>
          </tr>
          <tr>
            <td><span class="dfe-pill dfe-pill--alpha">Alpha</span></td>
            <td><code class="doc-inline-code">#fef0e7</code></td>
            <td><code class="doc-inline-code">#a04000</code></td>
            <td><code class="doc-inline-code">#f4c49a</code></td>
          </tr>
          <tr>
            <td><span class="dfe-pill dfe-pill--beta">Beta</span></td>
            <td><code class="doc-inline-code">#e3f5eb</code></td>
            <td><code class="doc-inline-code">#00703c</code></td>
            <td><code class="doc-inline-code">#9fd4b2</code></td>
          </tr>
          <tr>
            <td><span class="dfe-pill dfe-pill--live">Live</span></td>
            <td><code class="doc-inline-code">#d2e2f1</code></td>
            <td><code class="doc-inline-code">#003078</code></td>
            <td><code class="doc-inline-code">#8ab0d4</code></td>
          </tr>
        </tbody>
      </table>
    </section>

    <!-- ── Accessibility ── -->
    <section class="doc-section">
      <h2 class="doc-section__title">Accessibility and contrast</h2>
      <p class="govuk-body">All text and interactive elements must meet <a href="https://www.w3.org/WAI/WCAG22/Understanding/contrast-minimum.html" class="govuk-link" rel="noopener noreferrer">WCAG 2.2 Success Criterion 1.4.3 — Contrast (Minimum)</a> at Level AA:</p>
      <ul class="govuk-list govuk-list--bullet">
        <li>Normal text (below 18pt / 14pt bold): minimum contrast ratio of <strong>4.5:1</strong></li>
        <li>Large text (18pt+ / 14pt+ bold): minimum contrast ratio of <strong>3:1</strong></li>
        <li>UI components and graphical objects: minimum contrast ratio of <strong>3:1</strong></li>
      </ul>
      <p class="govuk-body">Never convey information using colour alone. Always pair colour with text, a pattern, or another visual indicator.</p>
      <div class="doc-note">
        <p class="govuk-body" style="margin:0">
          <strong>Using tints on dark backgrounds:</strong> Light tints (80%, 95%) are suitable as backgrounds with dark text.
          Dark shades (25%, 50%) are suitable as text or borders on white/light backgrounds.
          Always verify contrast ratios using a tool such as <a href="https://webaim.org/resources/contrastchecker/" class="govuk-link" rel="noopener noreferrer">WebAIM Contrast Checker</a>.
        </p>
      </div>
    </section>

    </main>
  </div>
</div>

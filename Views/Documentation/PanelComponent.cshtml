                  </div>
                </div>
              </div>
            }
          </div>
        </div>
      </div>

      <table class="doc-table">
        <thead>
          <tr><th>Colour</th><th>Use for</th></tr>
        </thead>
        <tbody>
          <tr><td><code class="doc-inline-code">blue</code> (default)</td><td>General requirements, standards, architecture</td></tr>
          <tr><td><code class="doc-inline-code">green</code></td><td>Accessibility, positive outcomes, completed items</td></tr>
          <tr><td><code class="doc-inline-code">orange</code></td><td>Warnings, items needing attention</td></tr>
          <tr><td><code class="doc-inline-code">red</code></td><td>Critical requirements, blockers, failures</td></tr>
          <tr><td><code class="doc-inline-code">yellow</code></td><td>Cautions, in-progress items</td></tr>
          <tr><td><code class="doc-inline-code">grey</code></td><td>Informational, optional, or low-priority items</td></tr>
          <tr><td><code class="doc-inline-code">black</code></td><td>High-emphasis items</td></tr>
        </tbody>
      </table>
    </section>

    <!-- ── Column layout ── -->
    <section class="doc-section">
      <h2 class="doc-section__title">Column layout</h2>
      <p class="govuk-body doc-section__description">The expandable body supports one or two columns. By default, if both <code class="doc-inline-code">[steps]</code> and <code class="doc-inline-code">[checks]</code> are present the layout is 50/50. If only one is present, or <code class="doc-inline-code">columns="1"</code> is set, the content spans the full width. Step and check items support inline markdown — <strong>bold</strong>, <em>italic</em>, <code class="doc-inline-code">`code`</code>, and <code class="doc-inline-code">[links](url)</code>.</p>

      <h3 class="govuk-heading-s">Two columns (default)</h3>

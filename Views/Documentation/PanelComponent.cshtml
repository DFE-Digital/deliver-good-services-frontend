            <button class="doc-copy-btn" type="button">Copy</button>
            <pre><code>[panel colour="blue" title="Custom labels"]
  [steps label="What to build"]
  1. Step one with **bold text**
  2. Step two with a [link](https://example.com)
  [/steps]
  [checks label="How we'll measure success"]
  - Metric one
  - Metric two
  [/checks]
[/panel]</code></pre>
          </div>
          <div id="ex-labels-razor" class="doc-tab-panel doc-example__code">
            <button class="doc-copy-btn" type="button">Copy</button>
            <pre><code>@Html.Raw(Html.Encode(@"@await Html.PartialAsync(""_DfeFPanelContainer"", new ViewDataDictionary(ViewData)
{
    { ""Title"", ""Custom labels"" },
    { ""Steps"", new[] { ""Step one with **bold text**"", ""Step two with a [link](https://example.com)"" } },
    { ""StepsLabel"", ""What to build"" },
    { ""Checks"", new[] { ""Metric one"", ""Metric two"" } },
    { ""ChecksLabel"", ""How we'll measure success"" },
    { ""Colour"", ""blue"" }
})"))</code></pre>
          </div>
        </div>
      </div>


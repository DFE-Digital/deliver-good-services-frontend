@* Helper: renders a three-tab code block (Razor / Markdown / HTML) *@
@* Called inline — not a real partial, just a local macro pattern via sections *@

<div class="doc-wrapper">
  <div class="doc-layout">
    @await Html.PartialAsync("~/Views/Documentation/_DocNavSections.cshtml")
    @await Html.PartialAsync("~/Views/Documentation/_DocSideNav.cshtml")
    <main class="doc-content" id="main-content">
    <div class="doc-content__header">
      <span class="doc-content__tag">Components</span>
      <h1 class="govuk-heading-l doc-content__title">Panel component</h1>
      <p class="doc-content__lead">A flexible card component for displaying requirements, standards, or guidance items — with optional tags, phase pills, expandable detail, and colour variants.</p>
    </div>

    <div class="doc-note">
      <p class="govuk-body" style="margin:0">The panel component can be used in three ways: as a <strong>Razor partial</strong> in views, as a <strong>shortcode</strong> in CMS markdown body content, or as raw <strong>HTML</strong>.</p>
    </div>

    <!-- ── Variant 1: Title + tags ── -->
    <section class="doc-section">
      <h2 class="doc-section__title">Variant 1 — Title and tags</h2>
      <p class="govuk-body doc-section__description">The simplest variant. Shows a title with one or more tags. No toggle or expandable content.</p>

      <div class="doc-example">
        <p class="doc-example__label">Preview</p>
        <div class="doc-example__preview">
          <div class="dfe-f-panel-component dfe-f-panel-component--blue">
            <div class="dfe-f-panel-component__header">
              <div class="dfe-f-panel-component__header-main">
                <div class="dfe-f-panel-component__tags"><span class="dfe-f-panel-component__tag">Mandatory</span><span class="dfe-f-panel-component__tag">Architecture / Standards</span></div>
                <h3 class="dfe-f-panel-component__title">DDT Standards compliance</h3>
              </div>
            </div>
          </div>
        </div>
        <div class="doc-example__tabs-wrapper">
          <div class="doc-tabs" role="tablist" aria-label="Code examples">
            <button class="doc-tab doc-tab--active" role="tab" aria-selected="true" data-target="ex1-razor">Razor</button>
            <button class="doc-tab" role="tab" aria-selected="false" data-target="ex1-markdown">Markdown</button>
            <button class="doc-tab" role="tab" aria-selected="false" data-target="ex1-html">HTML</button>
          </div>
          <div id="ex1-razor" class="doc-tab-panel doc-tab-panel--active doc-example__code">
            <button class="doc-copy-btn" type="button">Copy</button>
            <pre><code>@Html.Raw(Html.Encode(razor1))</code></pre>
          </div>
          <div id="ex1-markdown" class="doc-tab-panel doc-example__code">
            <button class="doc-copy-btn" type="button">Copy</button>
            <pre><code>@Html.Raw(Html.Encode(md1))</code></pre>
          </div>
          <div id="ex1-html" class="doc-tab-panel doc-example__code">
            <button class="doc-copy-btn" type="button">Copy</button>
            <pre><code>@Html.Raw(Html.Encode(html1))</code></pre>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Variant 2: Title + tags + description ── -->
    <section class="doc-section">
      <h2 class="doc-section__title">Variant 2 — Title, tags, and description</h2>

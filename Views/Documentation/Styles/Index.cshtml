@{
  ViewData["Title"] = "Styles";
}

@section Styles { <link rel="stylesheet" href="~/css/documentation.css" asp-append-version="true" /> }
@section Breadcrumbs {
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="/">Home</a></li>
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="/documentation">Documentation</a></li>
  <li class="govuk-breadcrumbs__list-item" aria-current="page">Styles</li>
}
@section Scripts { <script src="/js/documentation.js"></script> }

<div class="doc-wrapper">
  <div class="doc-layout">
    @await Html.PartialAsync("~/Views/Documentation/_DocNavSections.cshtml")
    @await Html.PartialAsync("~/Views/Documentation/_DocSideNav.cshtml")
    <main class="doc-content" id="main-content">
      <div class="doc-content__header">
        <span class="doc-content__tag">Styles</span>
        <h1 class="govuk-heading-l doc-content__title">Styles</h1>
        <p class="doc-content__lead">GOV.UK Frontend typography, layout, and visual design used across the Service Manual.</p>
      </div>
      <div class="doc-card-grid">
        <a href="/documentation/styles/typography" class="doc-card"><span class="doc-card__category">Styles</span><h3 class="doc-card__title">Typography</h3><p class="doc-card__description">Type scale and conventions.</p></a>
        <a href="/documentation/styles/headings" class="doc-card"><span class="doc-card__category">Styles</span><h3 class="doc-card__title">Headings</h3><p class="doc-card__description">Sizes and markdown mapping.</p></a>
        <a href="/documentation/styles/links" class="doc-card"><span class="doc-card__category">Styles</span><h3 class="doc-card__title">Links</h3><p class="doc-card__description">Standard and new-tab links.</p></a>
        <a href="/documentation/styles/inset-text" class="doc-card"><span class="doc-card__category">Styles</span><h3 class="doc-card__title">Inset text</h3><p class="doc-card__description">Blockquotes and callouts.</p></a>
        <a href="/documentation/styles/tables" class="doc-card"><span class="doc-card__category">Styles</span><h3 class="doc-card__title">Tables</h3><p class="doc-card__description">Markdown tables and alignment.</p></a>
        <a href="/documentation/styles/horizontal-rule" class="doc-card"><span class="doc-card__category">Styles</span><h3 class="doc-card__title">Horizontal rule</h3><p class="doc-card__description">Section breaks.</p></a>
        <a href="/documentation/styles/colour" class="doc-card"><span class="doc-card__category">Styles</span><h3 class="doc-card__title">Colour</h3><p class="doc-card__description">Palette and phase colours.</p></a>
      </div>
    </main>
  </div>
</div>

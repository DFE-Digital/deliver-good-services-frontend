@{
  ViewData["Title"] = "Detailed guide – Templates";
}

@section Styles { <link rel="stylesheet" href="~/css/documentation.css" asp-append-version="true" /> }
@section Breadcrumbs {
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="/">Home</a></li>
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="/documentation">Documentation</a></li>
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="/documentation/templates">Templates</a></li>
  <li class="govuk-breadcrumbs__list-item" aria-current="page">Detailed guide</li>
}
@section Scripts { <script src="/js/documentation.js"></script> }

<div class="doc-wrapper">
  <div class="doc-layout">
    @await Html.PartialAsync("~/Views/Documentation/_DocNavSections.cshtml")
    @await Html.PartialAsync("~/Views/Documentation/_DocSideNav.cshtml")
    <main class="doc-content" id="main-content">
      <div class="doc-content__header">
        <span class="doc-content__tag">Templates</span>
        <h1 class="govuk-heading-l doc-content__title">Detailed guide</h1>
        <p class="doc-content__lead">A multi-page guide made up of an overview (body on the guide) and optional detailed guide pages. One template serves both the overview and each child page.</p>
      </div>
      <section class="doc-section">
        <h2 class="doc-section__title">When to use</h2>
        <p class="govuk-body">Use a <strong>Detailed guide</strong> when the guidance spans one or more pages. The guide has a title and meta description; the overview body is shown at <code>/guidance/guides/{slug}</code>. Child pages are at <code>/guidance/guides/{slug}/{page-slug}</code>. The same view template is used for both. Assign the guide to a collection and use <em>applicable phases</em> so it can be listed on phase-specific views. Use <em>hideContentsOnPrimaryPage</em> only on the overview to hide the contents list there; child pages always show the contents when there are multiple pages.</p>
      </section>
      <section class="doc-section">
        <h2 class="doc-section__title">Fields</h2>
        <table class="govuk-table doc-table">
          <thead><tr><th>Field</th><th>Type</th><th>Notes</th></tr></thead>
          <tbody>
            <tr><td>title</td><td>String</td><td>Required, unique. Guide title.</td></tr>
            <tr><td>slug</td><td>UID (from title)</td><td>URL path for the guide.</td></tr>
            <tr><td>metaDescription</td><td>Text (max 240)</td><td>Required. SEO and preview.</td></tr>
            <tr><td>detailed_guide_pages</td><td>Relation (Detailed guide page)</td><td>One-to-many. Pages in this guide (order can be managed in CMS).</td></tr>
            <tr><td>relatedContent</td><td>Component (content.related-content)</td><td>Repeatable.</td></tr>
            <tr><td>userNeeds</td><td>Component (content.user-need)</td><td>Repeatable.</td></tr>
            <tr><td>applicable_phases</td><td>Relation (Phase)</td><td>Many-to-many. Phases this guide applies to (for phase page listing).</td></tr>
            <tr><td>hideContentsOnPrimaryPage</td><td>Boolean</td><td>Default false. When true, the contents list is hidden on the guide's primary (overview) page.</td></tr>
            <tr><td>collection</td><td>Relation (Collection)</td><td>Many-to-one. The collection this guide belongs to.</td></tr>
          </tbody>
        </table>
      </section>
      <p class="govuk-body">The same template (<code>Views/Templates/DetailedGuide.cshtml</code>) is used for the guide overview and for each child page; the controller builds a unified <code>GuidePageViewModel</code> from either the guide or the guide page.</p>
    </main>
  </div>
</div>

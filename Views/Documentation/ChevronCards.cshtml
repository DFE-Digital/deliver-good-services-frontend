    <!-- Action list: chevroncard ordered / unordered -->
    <section class="doc-section">
      <h2 class="doc-section__title">Action list (chevroncard ordered / unordered)</h2>
      <p class="govuk-body doc-section__description">Full-width link list with a chevron icon on each item. Use <code class="doc-inline-code">[chevroncard ordered]</code> for a numbered list (<code class="doc-inline-code">ol</code>) or <code class="doc-inline-code">[chevroncard unordered]</code> for a plain list (<code class="doc-inline-code">ul</code>). Each item is a single link; no description. Available as markdown shortcode, Razor partial <code class="doc-inline-code">_ActionList</code>, or raw HTML with classes <code class="doc-inline-code">govuk-list dfe-action-list</code>.</p>

      <h3 class="govuk-heading-m">Ordered (numbered)</h3>
      <div class="doc-example">
        <p class="doc-example__label">Preview</p>
        <div class="doc-example__preview">
          @await Html.PartialAsync("_ActionList", new ViewDataDictionary(ViewData) { { "Items", actionListItems }, { "Ordered", true } })
        </div>
        <div class="doc-example__tabs-wrapper">
          <div class="doc-tabs" role="tablist" aria-label="Code examples">
            <button class="doc-tab doc-tab--active" role="tab" aria-selected="true" data-target="action-ordered-razor">Razor</button>
            <button class="doc-tab" role="tab" aria-selected="false" data-target="action-ordered-md">Markdown</button>
            <button class="doc-tab" role="tab" aria-selected="false" data-target="action-ordered-html">HTML</button>
          </div>
          <div id="action-ordered-razor" class="doc-tab-panel doc-tab-panel--active doc-example__code"><pre><code>@Html.Raw(Html.Encode(actionListOrderedRazor))</code></pre></div>
          <div id="action-ordered-md" class="doc-tab-panel doc-example__code"><pre><code>@Html.Raw(Html.Encode(actionListOrderedMarkdown))</code></pre></div>
          <div id="action-ordered-html" class="doc-tab-panel doc-example__code"><pre><code>@Html.Raw(Html.Encode(actionListOrderedHtml))</code></pre></div>
        </div>
      </div>

      <h3 class="govuk-heading-m">Unordered (plain list)</h3>
      <div class="doc-example">
        <p class="doc-example__label">Preview</p>
        <div class="doc-example__preview">
          @await Html.PartialAsync("_ActionList", new ViewDataDictionary(ViewData) { { "Items", actionListItems.Take(2).Select(x => new { Title = x.Title.Replace("1. ", "").Replace("2. ", ""), x.Href, x.OpenInNewTab }) }, { "Ordered", false } })
        </div>
        <div class="doc-example__tabs-wrapper">
          <div class="doc-tabs" role="tablist" aria-label="Code examples">
            <button class="doc-tab doc-tab--active" role="tab" aria-selected="true" data-target="action-unordered-razor">Razor</button>
            <button class="doc-tab" role="tab" aria-selected="false" data-target="action-unordered-md">Markdown</button>
            <button class="doc-tab" role="tab" aria-selected="false" data-target="action-unordered-html">HTML</button>
          </div>
          <div id="action-unordered-razor" class="doc-tab-panel doc-tab-panel--active doc-example__code"><pre><code>@Html.Raw(Html.Encode(actionListUnorderedRazor))</code></pre></div>
          <div id="action-unordered-md" class="doc-tab-panel doc-example__code"><pre><code>@Html.Raw(Html.Encode(actionListUnorderedMarkdown))</code></pre></div>
          <div id="action-unordered-html" class="doc-tab-panel doc-example__code"><pre><code>@Html.Raw(Html.Encode(actionListUnorderedHtml))</code></pre></div>
        </div>
      </div>

      <p class="govuk-body"><strong>Action list Razor</strong> <code class="doc-inline-code">_ActionList</code> ViewData: <code class="doc-inline-code">Items</code> (each item: <code class="doc-inline-code">Title</code>, <code class="doc-inline-code">Href</code>, optional <code class="doc-inline-code">OpenInNewTab</code>), <code class="doc-inline-code">Ordered</code> (bool, default true). <strong>Markdown</strong>: <code class="doc-inline-code">[chevroncard ordered]</code> or <code class="doc-inline-code">[chevroncard unordered]</code> with <code class="doc-inline-code">[card title="..." href="..." external="true"]</code> lines.</p>
    </section>


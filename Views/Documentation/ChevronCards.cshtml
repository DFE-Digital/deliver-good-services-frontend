<div class="doc-wrapper">
  <div class="doc-layout">
    @await Html.PartialAsync("~/Views/Documentation/_DocNavSections.cshtml")
    @await Html.PartialAsync("~/Views/Documentation/_DocSideNav.cshtml")
    <main class="doc-content" id="main-content">
    <div class="doc-content__header">
      <span class="doc-content__tag">Components</span>
      <h1 class="govuk-heading-l doc-content__title">Card list</h1>
      <p class="doc-content__lead">A simple list of fully clickable cards: each item is one link with a title and description. No chevron icon. Based on the <a href="https://components.publishing.service.gov.uk/component-guide/cards" class="govuk-link" target="_blank" rel="noopener noreferrer">GOV.UK cards component</a>. Use for “Services and information”–style navigation or any list of related links.</p>
      <p class="govuk-body">Available as a Razor partial (<code class="doc-inline-code">_CardList</code> or legacy <code class="doc-inline-code">_ChevronCards</code>), markdown shortcode <code class="doc-inline-code">[chevron-cards]</code> or <code class="doc-inline-code">[card-list]</code>, or raw HTML. Choose a layout: single column (default), two columns, or three columns on desktop.</p>
      <p class="govuk-body">For a list of full-width links with a chevron icon (numbered or plain), use the <strong>action list</strong>: <code class="doc-inline-code">[chevroncard ordered]</code> or <code class="doc-inline-code">[chevroncard unordered]</code> (see below).</p>
    </div>

    <!-- Variant: Default (with heading, single column) -->
    <section class="doc-section">
      <h2 class="doc-section__title">With section heading (default)</h2>
      <p class="govuk-body doc-section__description">Single-column list with an optional <code class="doc-inline-code">h2</code> above the cards. Each card is a single link; the whole card is clickable.</p>
      <div class="doc-example">
        <p class="doc-example__label">Preview</p>
        <div class="doc-example__preview">
          @await Html.PartialAsync("_ChevronCards", new ViewDataDictionary(ViewData) { { "Heading", "Services and information" }, { "Items", sampleItems } })
        </div>
        <div class="doc-example__tabs-wrapper">
          <div class="doc-tabs" role="tablist" aria-label="Code examples">
            <button class="doc-tab doc-tab--active" role="tab" aria-selected="true" data-target="v1-razor">Razor</button>
            <button class="doc-tab" role="tab" aria-selected="false" data-target="v1-md">Markdown</button>
            <button class="doc-tab" role="tab" aria-selected="false" data-target="v1-html">HTML</button>
          </div>
          <div id="v1-razor" class="doc-tab-panel doc-tab-panel--active doc-example__code"><pre><code>@Html.Raw(Html.Encode(variantDefaultRazor))</code></pre></div>
          <div id="v1-md" class="doc-tab-panel doc-example__code"><pre><code>@Html.Raw(Html.Encode(variantDefaultMarkdown))</code></pre></div>
          <div id="v1-html" class="doc-tab-panel doc-example__code"><pre><code>@Html.Raw(Html.Encode(variantDefaultHtml))</code></pre></div>
        </div>
      </div>
    </section>

    <!-- Variant: Without heading -->
    <section class="doc-section">
      <h2 class="doc-section__title">Without section heading</h2>
      <p class="govuk-body doc-section__description">Omit the <code class="doc-inline-code">Heading</code> parameter (or <code class="doc-inline-code">heading</code> in markdown) for a list with no top border on the first card. Use when the page context already provides a heading.</p>
      <div class="doc-example">
        <p class="doc-example__label">Preview</p>
        <div class="doc-example__preview">
          @await Html.PartialAsync("_ChevronCards", new ViewDataDictionary(ViewData) { { "Items", sampleItems.Take(2) } })
        </div>
        <div class="doc-example__tabs-wrapper">
          <div class="doc-tabs" role="tablist" aria-label="Code examples">
            <button class="doc-tab doc-tab--active" role="tab" aria-selected="true" data-target="v2-razor">Razor</button>
            <button class="doc-tab" role="tab" aria-selected="false" data-target="v2-md">Markdown</button>
            <button class="doc-tab" role="tab" aria-selected="false" data-target="v2-html">HTML</button>
          </div>
          <div id="v2-razor" class="doc-tab-panel doc-tab-panel--active doc-example__code"><pre><code>@Html.Raw(Html.Encode(variantNoHeadingRazor))</code></pre></div>
          <div id="v2-md" class="doc-tab-panel doc-example__code"><pre><code>@Html.Raw(Html.Encode(variantNoHeadingMarkdown))</code></pre></div>
          <div id="v2-html" class="doc-tab-panel doc-example__code"><pre><code>@Html.Raw(Html.Encode(variantNoHeadingHtml))</code></pre></div>
        </div>
      </div>
    </section>

    <!-- Variant: External links -->
    <section class="doc-section">
      <h2 class="doc-section__title">External links (open in new tab)</h2>
      <p class="govuk-body doc-section__description">Set <code class="doc-inline-code">OpenInNewTab = true</code> per item (Razor) or <code class="doc-inline-code">external="true"</code> on each <code class="doc-inline-code">[card]</code> in markdown. Links get <code class="doc-inline-code">target="_blank"</code> and <code class="doc-inline-code">rel="noopener noreferrer"</code>. Consider adding “(opens in new tab)” in the description or using the new-tab link pattern for screen readers.</p>
      <div class="doc-example">
        <p class="doc-example__label">Preview</p>
        <div class="doc-example__preview">
          @{
            var externalItems = new[]
            {
              new { Title = "Design Manual", Description = "Standards and guidance for DfE design.", Href = "https://design.education.gov.uk/", OpenInNewTab = true },
              new { Title = "Find and Use Standards", Description = "Digital, data and technology standards.", Href = "https://standards.education.gov.uk/", OpenInNewTab = true }
            };
          }
          @await Html.PartialAsync("_ChevronCards", new ViewDataDictionary(ViewData) { { "Heading", "External resources" }, { "Items", externalItems } })
        </div>
        <div class="doc-example__tabs-wrapper">
          <div class="doc-tabs" role="tablist" aria-label="Code examples">
            <button class="doc-tab doc-tab--active" role="tab" aria-selected="true" data-target="v3-razor">Razor</button>
            <button class="doc-tab" role="tab" aria-selected="false" data-target="v3-md">Markdown</button>
            <button class="doc-tab" role="tab" aria-selected="false" data-target="v3-html">HTML</button>
          </div>
          <div id="v3-razor" class="doc-tab-panel doc-tab-panel--active doc-example__code"><pre><code>@Html.Raw(Html.Encode(variantExternalRazor))</code></pre></div>
          <div id="v3-md" class="doc-tab-panel doc-example__code"><pre><code>@Html.Raw(Html.Encode(variantExternalMarkdown))</code></pre></div>
          <div id="v3-html" class="doc-tab-panel doc-example__code"><pre><code>@Html.Raw(Html.Encode(variantExternalHtml))</code></pre></div>
        </div>
      </div>
    </section>

    <!-- Variant: Two-column layout -->
    <section class="doc-section">
      <h2 class="doc-section__title">Two-column layout</h2>
      <p class="govuk-body doc-section__description">Set <code class="doc-inline-code">Columns = 2</code> (Razor) or <code class="doc-inline-code">columns="2"</code> on the shortcode. Cards sit in two columns from tablet width (641px) up. Add class <code class="doc-inline-code">dfe-card-list--2-col</code> to the <code class="doc-inline-code">ul</code> for raw HTML.</p>
      <div class="doc-example">
        <p class="doc-example__label">Preview</p>
        <div class="doc-example__preview">
          @{
            var fourItems = sampleItems.Concat(new[] { new { Title = "Childcare and parenting", Description = "Childcare, schools and benefits for children.", Href = "/childcare", OpenInNewTab = false } }).ToArray();
          }
          @await Html.PartialAsync("_ChevronCards", new ViewDataDictionary(ViewData) { { "Heading", "Services and information" }, { "Items", fourItems }, { "Columns", 2 } })
        </div>
        <div class="doc-example__tabs-wrapper">
          <div class="doc-tabs" role="tablist" aria-label="Code examples">
            <button class="doc-tab doc-tab--active" role="tab" aria-selected="true" data-target="v4-razor">Razor</button>
            <button class="doc-tab" role="tab" aria-selected="false" data-target="v4-md">Markdown</button>
            <button class="doc-tab" role="tab" aria-selected="false" data-target="v4-html">HTML</button>
          </div>
          <div id="v4-razor" class="doc-tab-panel doc-tab-panel--active doc-example__code"><pre><code>@Html.Raw(Html.Encode(variant2ColRazor))</code></pre></div>
          <div id="v4-md" class="doc-tab-panel doc-example__code"><pre><code>@Html.Raw(Html.Encode(variant2ColMarkdown))</code></pre></div>
          <div id="v4-html" class="doc-tab-panel doc-example__code"><pre><code>@Html.Raw(Html.Encode(variant2ColHtml))</code></pre></div>
        </div>
      </div>
    </section>

    <!-- Variant: Three-column layout -->
    <section class="doc-section">
      <h2 class="doc-section__title">Three-column layout</h2>
      <p class="govuk-body doc-section__description">Set <code class="doc-inline-code">Columns = 3</code> (Razor) or <code class="doc-inline-code">columns="3"</code> on the shortcode. Three columns from 769px. Add class <code class="doc-inline-code">dfe-card-list--3-col</code> to the <code class="doc-inline-code">ul</code> for raw HTML.</p>
      <div class="doc-example">

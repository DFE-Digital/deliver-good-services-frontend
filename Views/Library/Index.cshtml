@{
    ViewData["Title"] = "My library";

    ViewBag.HeroType = "collection";
    ViewBag.HeroTitle = "My library";
    ViewBag.HeroIntro = "A personalised list of pages you've saved. This list is kept in your browser on this device.";
    ViewBag.HeroMetaDescription = string.Empty;
    ViewBag.HeroAudienceTags = new List<dynamic>();
    ViewBag.HeroBadgeText = "Personalised";
    ViewBag.UseInverseNav = true; // Library page uses inverse nav for better contrast with hero
    ViewBag.HideBadge = true; // Hide badge on library page as it's not a specific content type
}

<div class="guide-modern guidance-index library-index">
    @await Html.PartialAsync("~/Views/Shared/_HeroSection.cshtml")
<div class="govuk-grid-row govuk-!-margin-bottom-6 govuk-!-margin-top-7" id="library-page">
    <div class="govuk-grid-column-full">
    <div class="guidance-body">
        <div class="govuk-grid-row">
            <aside class="govuk-grid-column-one-quarter guidance-filters" aria-label="Filter saved items">
                <div class="gf-block">
                    <span class="gf-title">Filter by type</span>
                    <div id="lib-type-filters" class="lib-filter-list" aria-live="polite">
                        <p class="govuk-body-s govuk-!-margin-bottom-0">Loading filters&hellip;</p>
                    </div>
                </div>
            </aside>

            <main class="govuk-grid-column-three-quarters guidance-results" aria-label="Saved library items">
                <section class="govuk-!-margin-bottom-6" aria-label="About my library">
                    <h2 class="govuk-heading-m govuk-!-margin-bottom-3">Saving items to your local library</h2>
                    <p class="govuk-body govuk-!-margin-bottom-3">As you browse guidance or standards, you can save items to your local library for easy access later.</p>
                    <p class="govuk-body govuk-!-margin-bottom-3">To save an item, select the <strong>Save</strong> button on guidance or standard pages. Once added the button will change to <strong>Saved</strong>. Selecting it again will remove the item from your library.</p>
                    <p class="govuk-body govuk-!-margin-bottom-3">Your library is stored in your browser's local storage, which means:</p>
                    <ul class="govuk-list govuk-list--bullet govuk-!-margin-bottom-0">
                        <li>saved items are only available on this device and browser</li>
                        <li>saved items are available between sessions on this device, even if you close your browser</li>
                        <li>clearing your browser's cache or storage will reset your library</li>
                        <li>you can remove individual items or clear all items from your library</li>
                </section>

                <div id="library-content" aria-live="polite" aria-busy="true">
                    <p class="govuk-body">Loading your saved items&hellip;</p>
                </div>
            </main>
        </div>
    </div>
</div>
    </div>
</div>
